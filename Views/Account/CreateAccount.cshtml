@model SchoolManagmentSystem.Models.Parent

@{
    ViewData["Title"] = "Create Account";
}

<head>

    <style>

        body{
            background-image: url(/Images/CreateAccountImages/BGImage1.png);
            background-size:cover;
        }

        .mainHeading{
            text-align:center;
            font-weight: 700;
            font-family: Dubai;
            font-size: 40px;
            
        }

        .smallParagraph{
            text-align: center;
        }

        .link{
            text-decoration:none;
            color:red;
        }

        .allItems{
            display: flex;
            justify-content: center;
        }

        .imageDiv{
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: red;
            background-image: url(/Images/CreateAccountImages/DisplayImage.png);
            width: 500px;
            height: 800px;
            
            box-shadow: 0 -5px 5px rgba(0, 0, 0, 0.1), -5px 0 5px rgba(0, 0, 0, 0.1), 0 5px 5px rgba(0, 0, 0, 0.1);
        }

        .regItems{
            display:flex;
            justify-content:center;
            align-items:center;
            background-color: white;
            width:600px;
            height:800px;
            
            box-shadow: 0 -5px 5px rgba(0, 0, 0, 0.1), 
            5px 0 5px rgba(0, 0, 0, 0.1),
            0 5px 5px rgba(0, 0, 0, 0.1);
        }

        .form-group{
            text-align:left;
            padding-top:25px;
        }

        .customTextBox{
            border:none;
            outline: none;
            box-shadow: none;
            border-radius: 0;
            border-bottom: 1px solid black;
            width:300px
        }

        .customTextBox:focus{
            box-shadow:none;
                border-bottom: 1px solid red;
            }

        .button{
            text-align:center;
            background-color: #f93a5b;
            color:white;
            width:270px;
            height:60px;
            border-radius:25px;
            border:none;
            font-size:25px;
        }

        .button:hover{
            text-align:center;
            background-color: #f93a5b;
            color:white;
            border-radius:25px;
            border:none;
            font-size:25px;
            transform: scale(1.1);
            transition: ease 0.2s all;
        }

            .button:active {
                text-align: center;
                background-color: #f93a5b;
                color: white;
                width: 270px;
                height: 60px;
                border-radius: 25px;
                border: none;
                font-size: 25px;
            }

            .button:focus-within {
                text-align: center;
                background-color: #f93a5b;
                color: white;
                width: 270px;
                height: 60px;
                border-radius: 25px;
                border: none;
                font-size: 25px;
            }

        .buttons{
            text-align: center;
        }


        @@media screen and (max-width: 950px) {
            .imageDiv{
                display:none;
            }

            .customTextBox{
                font-size: 20px;
            }
        }


    </style>
</head>

<body>
   
    <div class="row allItems">
        <div class="imageDiv">
            
        </div>
        
        <div class="regItems">
            
            <form asp-action="CreateAccount" style="font-family:Dubai">
                <h1 class="mainHeading" style="">Create Account</h1>
                <p class="smallParagraph">Already have an account? <a class="link" asp-action="Login">Click here</a></p>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <input asp-for="IdNumber" class="form-control customTextBox" type="text" inputmode="numeric" placeholder="ID Number" />
                    <span asp-validation-for="IdNumber" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input asp-for="FirstName" class="form-control customTextBox" placeholder="First Name" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input asp-for="Surname" class="form-control customTextBox" placeholder="Surname" />
                    <span asp-validation-for="Surname" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input asp-for="Username" class="form-control customTextBox" placeholder="Username" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input asp-for="Email" class="form-control customTextBox" placeholder="Email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input asp-for="Password" class="form-control customTextBox" type="password" name="Password" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group buttons">
                    <input type="submit" value="Create" class="button btn btn-primary" />
                </div>
            </form>
        </div>
    </div>


</body>




@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
