@model SchoolManagmentSystem.Models.Parent

<head>
    <style>
        body {
            background-image: url(/Images/LoginImages/BGImage1.png);
            background-size: cover;
        }

        .mainHeading {
            text-align: center;
            font-weight: 700;
            font-family: Dubai;
            font-size: 40px;
        }

        .allItems {
            display: flex;
            justify-content: center;
            margin-top: 50px;
        }

        .imageDiv {
            display: flex;
            justify-content: center;
            align-items: center;
            background-image: url(/Images/LoginImages/DisplayImage.png);
            background-size: cover;
            width: 500px;
            height: 600px;
            box-shadow: 0 -5px 5px rgba(0, 0, 0, 0.1), -5px 0 5px rgba(0, 0, 0, 0.1), 0 5px 5px rgba(0, 0, 0, 0.1);
        }

        .regItems {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background-color: white;
            width: 600px;
            height: 600px;
            box-shadow: 0 -5px 5px rgba(0, 0, 0, 0.1), 5px 0 5px rgba(0, 0, 0, 0.1), 0 5px 5px rgba(0, 0, 0, 0.1);
            padding: 20px;
        }

        .customTextBox {
            border: none;
            outline: none;
            border-bottom: 1px solid black;
            width: 300px;
            margin-bottom: 20px;
        }

            .customTextBox:focus {
                border-bottom: 1px solid red;
                box-shadow: none;
            }

        .button {
            background-color: #f93a5b;
            color: white;
            width: 270px;
            height: 60px;
            border-radius: 25px;
            border: none;
            font-size: 22px;
            transition: ease 0.2s all;
        }

            .button:hover {
                transform: scale(1.05);
                background-color: #f93a5b;
                color: white;
            }

        .alert-custom {
            color: green;
            font-weight: bold;
            margin-bottom: 15px;
            text-align: center;
        }
    </style>
</head>

<body>
    <div class="row allItems">
        <div class="imageDiv"></div>
        <div class="regItems">
            <h1 class="mainHeading">Forgot Password</h1>
            <p style="text-align:center">Enter your email and we'll send a reset link.</p>

            @if (ViewBag.Message != null)
            {
                <p class="alert-custom">@ViewBag.Message</p>
            }

            <form asp-action="ForgotPassword" method="post">
                <div class="form-group" style="text-align:center">
                    <input type="email" name="email" class="form-control customTextBox" placeholder="Enter Registered Email" required />
                </div>

                <div style="text-align:center; margin-top:30px;">
                    <input type="submit" value="Send Link" class="button" />
                </div>

                <div style="margin-top:20px; text-align:center">
                    <a href="@Url.Action("Login", "Account")" style="color:red; text-decoration:none">Back to Login</a>
                </div>
            </form>
        </div>
    </div>
</body>