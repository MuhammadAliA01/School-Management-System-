@{
    Layout = null; 
}

<head>
    <style>
        body {
            background-image: url(/Images/LoginImages/BGImage1.png);
            background-size: cover;
            font-family: Dubai, sans-serif;
        }

        .mainHeading {
            text-align: center;
            font-weight: 700;
            font-size: 35px;
            margin-bottom: 10px;
        }

        .allItems {
            display: flex;
            justify-content: center;
            margin-top: 50px;
        }

        .imageDiv {
            display: flex;
            justify-content: center;
            align-items: center;
            background-image: url(/Images/LoginImages/DisplayImage.png);
            background-size: cover;
            width: 500px;
            height: 600px;
            box-shadow: 0 -5px 5px rgba(0, 0, 0, 0.1), -5px 0 5px rgba(0, 0, 0, 0.1), 0 5px 5px rgba(0, 0, 0, 0.1);
        }

        .regItems {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background-color: white;
            width: 600px;
            height: 600px;
            box-shadow: 0 -5px 5px rgba(0, 0, 0, 0.1), 5px 0 5px rgba(0, 0, 0, 0.1), 0 5px 5px rgba(0, 0, 0, 0.1);
            padding: 20px;
        }

        .customTextBox {
            border: none;
            outline: none;
            border-bottom: 1px solid black;
            width: 300px;
            margin-bottom: 15px;
            display: block;
            padding: 10px;
        }

            .customTextBox:focus {
                border-bottom: 1px solid red;
                box-shadow: none;
            }

        .button {
            background-color: #f93a5b;
            color: white;
            width: 270px;
            height: 60px;
            border-radius: 25px;
            border: none;
            font-size: 22px;
            transition: ease 0.2s all;
            margin-top: 20px;
        }

            .button:hover {
                transform: scale(1.05);
                background-color: #f93a5b;
            }

        .text-danger {
            color: red;
            font-size: 14px;
            text-align: center;
        }
    </style>
</head>

<body>
    <div class="row allItems">
        <div class="imageDiv"></div>
        <div class="regItems">
            <h1 class="mainHeading">New Password</h1>
            <p style="text-align:center">Set your new secure password below.</p>

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" name="token" value="@ViewBag.Token" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group" style="text-align:center">
                    <input type="password" name="newPassword" class="form-control customTextBox" placeholder="New Password" required />
                </div>

                <div class="form-group" style="text-align:center">
                    <input type="password" name="confirmPassword" class="form-control customTextBox" placeholder="Confirm New Password" required />
                </div>

                <div style="text-align:center;">
                    <input type="submit" value="Reset Password" class="button" />
                </div>
            </form>
        </div>
    </div>
</body>