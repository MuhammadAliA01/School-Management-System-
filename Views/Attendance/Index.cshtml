@model SchoolManagmentSystem.Models.MorningAttendanceData

<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">

<style>
    /* Clean, simple styling matching your app */
    body {
        font-family: 'Nunito', sans-serif;
        background: #FFFBF5;
    }

    .card {
        max-width: 650px;
        margin: 40px auto;
        background: white;
        border: 2px solid #F5D9B8;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }

    .header {
        background: #E8521A;
        color: white;
        padding: 20px;
        text-align: center;
    }

        .header h2 {
            margin: 0;
            font-family: 'Playfair Display', serif;
        }

    .body {
        padding: 25px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 25px;
    }

    th {
        text-align: left;
        background: #FFF5EB;
        color: #B85C2A;
        padding: 12px;
        font-size: 14px;
        text-transform: uppercase;
    }

    td {
        padding: 12px;
        border-bottom: 1px solid #eee;
        color: #3D1F0A;
        font-weight: 600;
    }

    select {
        padding: 8px;
        border-radius: 5px;
        border: 1px solid #F5D9B8;
        width: 100%;
        font-family: 'Nunito', sans-serif;
        outline: none;
    }

        select:focus {
            border-color: #E8521A;
        }

    .btn-save {
        background: #E8521A;
        color: white;
        border: none;
        padding: 14px;
        width: 100%;
        border-radius: 8px;
        font-weight: bold;
        font-size: 16px;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-save:hover {
            background: #C23E10;
        }

    .success {
        background: #d4edda;
        color: #155724;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        text-align: center;
        font-weight: bold;
        border: 1px solid #c3e6cb;
    }
</style>

<div class="card">
    <div class="header">
        <h2>Morning Registration</h2>
    </div>

    <div class="body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success">✓ @TempData["SuccessMessage"]</div>
        }

        <form asp-action="Index" method="post">

            <div style="margin-bottom: 20px;">
                <label style="font-weight: bold; color: #B85C2A; display: block; margin-bottom: 5px;">Date:</label>
                <input asp-for="Date" type="date" style="padding: 10px; border-radius: 5px; border: 1px solid #F5D9B8; width: 100%; box-sizing: border-box; font-family: 'Nunito', sans-serif;" />
            </div>

            <table>
                <tr>
                    <th>Student Name</th>
                    <th style="width: 150px;">Status</th>
                </tr>

                @for (int i = 0; i < Model.Students.Count; i++)
                {
                    <tr>
                        <td>
                            <input type="hidden" asp-for="Students[i].StudentId" />
                            <input type="hidden" asp-for="Students[i].Name" />

                            @Model.Students[i].Name
                        </td>
                        <td>
                            <select asp-for="Students[i].Status">
                                <option value="Present">Present</option>
                                <option value="Absent">Absent</option>
                                <option value="Late">Late</option>
                            </select>
                        </td>
                    </tr>
                }
            </table>

            <button type="submit" class="btn-save">Save Attendance</button>
        </form>
    </div>
</div>