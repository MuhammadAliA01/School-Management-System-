@model IEnumerable<Event>

<table class="table">
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.EventDate.ToShortDateString()</td>
            <td>
                Attendees: @item.RSVPs.Count(r => r.IsAttending)
            </td>
            <td>
                <form asp-action="RSVP" method="post">
                    <input type="hidden" name="eventId" value="@item.EventId" />
                    <input type="text" name="userName" placeholder="Your Name" required />
                    <button type="submit" name="attending" value="true" class="btn btn-success">Accept</button>
                    <button type="submit" name="attending" value="false" class="btn btn-danger">Decline</button>
                </form>
            </td>
        </tr>
    }
</table>
<div id="calendar"></div>

<!-- Reference FullCalendar JS and CSS -->
<link href="https://jsdelivr.net" rel="stylesheet" />
<script src="https://jsdelivr.net"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            events: '/Events/GetCalendarEvents', // This endpoint will return your DB events
            selectable: true,
            dateClick: function(info) {
                // Trigger your "Create Event" modal or logic here
                alert('Date clicked: ' + info.dateStr);
            }
        });
        calendar.render();
    });
</script>