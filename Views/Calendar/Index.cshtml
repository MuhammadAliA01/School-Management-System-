link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>

<div id="calendar" style="min-height: 600px;"></div>
<div id="calendar"></div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',

            
            events: '/events',

            
            eventDataTransform: function(eventData) {
                return {
                    id: eventData.id,
                    title: eventData.title,
                    start: eventData.start || eventData.startTime,
                    end: eventData.end || eventData.endTime,
                    description: eventData.description || eventData.desc
                };
            }
            });

                eventContent: function(arg) {
                    // This creates the custom look inside the calendar cell
                    let container = document.createElement('div');
                    container.className = "p-1";

                    let title = document.createElement('div');
                    title.className = "fw-bold small";
                    title.innerText = arg.event.title;

                    let count = document.createElement('div');
                    count.className = "extra-small text-muted";
                    
                    count.innerText = `Attendees: ${arg.event.extendedProps.attendeeCount || 0}`;

                    container.appendChild(title);
                    container.appendChild(count);

                    return { domNodes: [container] };
                }
            });

            calendar.render();
        });
    </script>
}
