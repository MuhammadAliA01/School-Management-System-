@model IEnumerable<SchoolManagmentSystem.Models.EventCalendar>

    <style>
        .orange-header {
            background-color: #FFF9F4;
            color: #E67E22;
            padding: 15px 20px;
            font-weight: 800;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            border: 1px solid #eee;
            border-radius: 8px;
            margin-top: 10px;
        }

        .details-box {
            background: white;
            border: 1px solid #eee;
            border-top: none;
            padding: 20px;
            border-radius: 0 0 8px 8px;
        }
    </style>

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold">School Event Records</h2>
            <a asp-action="Create" class="btn btn-warning text-white fw-bold px-4">+ Add Event</a>
        </div>

        @foreach (var item in Model)
        {
            <div class="orange-header" data-bs-toggle="collapse" data-bs-target="#event-@item.Id">
                <span><i class="fas fa-calendar-day me-2"></i> @item.Title</span>
                <span>
                    @item.StartTime.ToString("MMM dd")
                    <i class="fas fa-chevron-down ms-2"></i>
                </span>
            </div>

            <div id="event-@item.Id" class="collapse">
                <div class="details-box shadow-sm">
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <p><strong>Details:</strong> @item.Desc</p>
                            <p><strong>Location:</strong> @item.Location</p>
                            <p class="mb-0">
                                <strong>Time:</strong> @item.StartTime.ToString("t") - @item.EndTime.ToString("t")
                            </p>
                        </div>
                    <div class="col-md-3 text-end border-start">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark w-100 mb-2">
                            Edit Details
                        </a>

                        <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-danger w-100" onclick="return confirm('Delete event?')">
                                Delete
                            </button>
                        </form>
                    </div>
                    </div>
                </div>
            </div>
        }
    </div>
