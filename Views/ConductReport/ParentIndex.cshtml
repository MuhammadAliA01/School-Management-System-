@model IEnumerable<SchoolManagmentSystem.Models.ConductReport>

@{
    ViewData["Title"] = "Conduct Dashboard";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container py-5">
    <div class="row align-items-center mb-5">
        <div class="col-md-6">
            <h2 class="fw-bold text-dark mb-1">@ViewBag.Name's Incidents</h2>
            
        </div>
        
    </div>

    

    <div class="card shadow border-0" style="border-radius: 20px;">
        <div class="table-responsive p-0">
            <table class="table table-hover mb-0" id="conductTable">
                <thead style="background-color: #f8f9fa;">
                    <tr>
                        <th class="py-3 text-uppercase small fw-bold text-muted">Date</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">Incident</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-center">Severity</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">Status</th>
                        <th class="pe-4 py-3 text-uppercase small fw-bold text-muted text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">


                    @foreach (var item in Model)
                    {
                        <tr class="align-middle">
                            
                            <td>
                                <div class="d-flex flex-column">
                                    <span class="fw-bold text-dark">@item.IncidentDate.ToString("dd MMM")</span>
                                    <span class="small text-muted">@item.IncidentDate.Year</span>
                                </div>
                            </td>

                            <td>
                                <span class="text-truncate d-inline-block fw-medium" style="max-width: 180px;">@item.Title</span>
                            </td>
                            <td class="text-center">
                                @if (item.Severity != null && item.Severity.Equals("High", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge rounded-pill bg-danger text-white px-3 shadow-sm">High</span>
                                }
                                else if (item.Severity != null && item.Severity.Equals("Medium", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge rounded-pill bg-orange text-white px-3 shadow-sm">Medium</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-warning text-dark px-3 shadow-sm">Low</span>
                                }
                            </td>
                            <td>
                                @if (item.IsViewedByParent)
                                {
                                    <div class="d-flex align-items-center justify-content-start">
                                        @* Unique data-bs-target using Item ID *@
                                        <button type="button" class="btn btn-sm p-0 border-0 text-start" data-bs-toggle="modal" data-bs-target="#modal-@item.Id">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2" style="cursor: pointer;">
                                                <i class="bi bi-eye-fill me-1"></i> Received
                                            </span>
                                            @if (!string.IsNullOrEmpty(item.ParentMessage))
                                            {
                                                <i class="bi bi-chat-left-text-fill text-primary ms-2" title="Click to view message"></i>
                                            }
                                        </button>
                                    </div>

                                    @* Unique ID for each modal *@
                                    <div class="modal fade" id="modal-@item.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content" style="border-radius: 15px;">
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="fw-bold text-dark">Parent Response</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body py-4 text-start">
                                                    <p class="small text-muted text-uppercase fw-bold mb-1">Student</p>
                                                    <p class="fw-bold mb-4">@item.Student?.FullName</p>

                                                    <div class="p-3 bg-light rounded-3 border-start border-primary border-4">
                                                        <label class="small text-muted fw-bold d-block mb-1">Parent's Message:</label>
                                                        @if (!string.IsNullOrEmpty(item.ParentMessage))
                                                        {
                                                            <p class="mb-0 text-dark italic">"@item.ParentMessage"</p>
                                                        }
                                                        else
                                                        {
                                                            <p class="mb-0 text-muted italic">The parent viewed this report but did not leave a comment.</p>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-0 pt-0">
                                                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-muted border px-2 italic">
                                        <i class="bi bi-clock-history me-1"></i> Pending
                                    </span>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm">
                                        <i class="bi bi-eye"></i> Details
                                    </a>

                                    
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Inter', sans-serif;
    }

    .table-hover tbody tr:hover {
        background-color: #fffaf7;
        transition: 0.2s ease-in-out;
    }

    .bg-orange {
        background-color: #fd7e14 !important;
    }

    .bg-danger {
        background-color: #dc3545 !important;
    }

    .bg-warning {
        background-color: #ffc107 !important;
    }

    .badge {
        font-weight: 700;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-outline-primary {
        border-color: #0d6efd;
        color: #0d6efd;
        border-width: 2px;
        font-weight: 600;
    }

        .btn-outline-primary:hover {
            background-color: #0d6efd;
            color: white;
        }

    .btn-outline-danger {
        border-color: #dc3545;
        color: #dc3545;
        border-width: 2px;
        font-weight: 600;
    }

        .btn-outline-danger:hover {
            background-color: #dc3545;
            color: white;
        }

    .italic {
        font-style: italic;
    }
</style>

<script>
    document.getElementById('dashboardSearch').addEventListener('keyup', function() {
        let filter = this.value.toLowerCase();
        let rows = document.querySelectorAll('#conductTable tbody tr');
        rows.forEach(row => {
            let text = row.innerText.toLowerCase();
            row.style.display = text.includes(filter) ? '' : 'none';
        });
    });
</script>   