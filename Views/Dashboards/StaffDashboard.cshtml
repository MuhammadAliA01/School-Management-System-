<head>
    <style>
        body{
            background-color:#eef2f6;
        }


        .actionsDiv{
            display:grid;
            grid-template-columns: 400px 400px 400px 400px;
            justify-content:center;
            gap: 30px;
        }

        .customActionBox{
            width:400px;
            height:300px;
            background-color:white;
            box-shadow: 0 -5px 5px rgba(0, 0, 0, 0.1), -5px 0 5px rgba(0, 0, 0, 0.1), 0 5px 5px rgba(0, 0, 0, 0.1);
            border: none;
            color: black;
            font-family:Dubai;
            font-size:25px;
        }

            .customActionBox:hover {
                width: 400px;
                height: 300px;
                background-color: white;
                box-shadow: 0 -5px 5px rgba(0, 0, 0, 0.1), -5px 0 5px rgba(0, 0, 0, 0.1), 0 5px 5px rgba(0, 0, 0, 0.1);
                border: none;
                color: black;
                font-family: Dubai;
                font-size: 25px;
            transform: scale(1.1);
            transition: ease 0.2s all;
        }

            .customActionBox:active {
                width: 400px;
                height: 300px;
                background-color: white;
                box-shadow: 0 -5px 5px rgba(0, 0, 0, 0.1), -5px 0 5px rgba(0, 0, 0, 0.1), 0 5px 5px rgba(0, 0, 0, 0.1);
                border: none;
                color: black;
                font-family: Dubai;
                font-size: 25px;
        }

            .customActionBox:focus-within {
                width: 400px;
                height: 300px;
                background-color: white;
                box-shadow: 0 -5px 5px rgba(0, 0, 0, 0.1), -5px 0 5px rgba(0, 0, 0, 0.1), 0 5px 5px rgba(0, 0, 0, 0.1);
                border: none;
                color: black;
                font-family: Dubai;
                font-size: 25px;
        }

        #enrolmentlist{
            background-image: url(/Images/StaffDashboardImages/Enrolmentlist.png);
            background-size:cover;
            background-size: 130px;
            background-repeat: no-repeat;
            background-position: center;
        }

        #employmentlist{
            background-image: url(/Images/StaffDashboardImages/EmploymentList.png);
            background-size: cover;
            background-size: 130px;
            background-repeat: no-repeat;
            background-position: center;
        }
        
        #incidentlist{
            background-image: url(https://www.freeiconspng.com/thumbs/error-icon/orange-error-icon-0.png);
            background-size: cover;
            background-size: 130px;
            background-repeat: no-repeat;
            background-position: center;
        }

        #teachingmethods{
            background-image: url(https://cdn-icons-png.flaticon.com/512/7941/7941461.png);
            background-size: cover;
            background-size: 130px;
            background-repeat: no-repeat;
            background-position: center;
        }

        #Training {
            background-image: url(https://cdn-icons-png.flaticon.com/512/7872/7872038.png);
            background-size: cover;
            background-size: 130px;
            background-repeat: no-repeat;
            background-position: center;
        }

        #Attendance {
            background-image: url(https://cdn-icons-png.freepik.com/256/18491/18491641.png?semt=ais_white_label);
            background-size: cover;
            background-size: 130px;
            background-repeat: no-repeat;
            background-position: center;
        }

        #AttendanceInsights {
            background-image: url(https://cdn-icons-png.flaticon.com/512/12044/12044015.png);
            background-size: cover;
            background-size: 130px;
            background-repeat: no-repeat;
            background-position: center;
        }

        #IED {
            background-image: url(https://cdn-icons-png.flaticon.com/512/5276/5276183.png);
            background-size: cover;
            background-size: 130px;
            background-repeat: no-repeat;
            background-position: center;
        }
    </style>
</head>

<body>
    <div class="actionsDiv">

        @if (ViewBag.teacher == true)
        {
            //this dashboard is for teachers

            <a asp-action="Index" asp-controller="ConductReport" class="btn btn-primary customActionBox" id="incidentlist">View Incidents</a>

            <a asp-action="Dashboard" asp-controller="TeachingMethods" class="btn btn-primary customActionBox" id="teachingmethods">Students</a>

            <a asp-action="Index" asp-controller="Attendance" class="btn btn-primary customActionBox" id="Attendance">Log Attendance</a>

            <a asp-action="Index" asp-controller="AttendanceInsights" class="btn btn-primary customActionBox" id="AttendanceInsights">Attendance Insights</a>

            <a asp-action="TrainingDashboard" asp-controller="Training" class="btn btn-primary customActionBox" id="Training">Training</a>

            <a asp-action="Index" asp-controller="IEP" class="btn btn-primary customActionBox" id="IED">Individual Education Plans</a>



        }
        else if (ViewBag.admin = true)
        {
             //this dashboard is for admins

            <a asp-action="StudentList" asp-controller="StudentApplications" class="btn btn-primary customActionBox" id="enrolmentlist">Enrolment Applications</a>

            <a asp-action="ApplicationList" asp-controller="Employment" class="btn btn-primary customActionBox" id="employmentlist">Employment Applications</a>
        }

        

        



    </div>
    
</body>








