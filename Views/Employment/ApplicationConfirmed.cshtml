@{
    ViewData["Title"] = "Success!";
}

<link href="https://api.fontshare.com/v2/css?f[]=satoshi@900,700,500,400&display=swap" rel="stylesheet">

<div class="viewport">
    <div class="glass-card">
        
        <div class="icon-sphere">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M22 2L11 13" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M22 2L15 22L11 13L2 9L22 2Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>

        <h1 class="heading">Thanks for submitting!</h1>
        <p class="sub-heading">Your application has been submitted!</p>

        <p class="interest-text">
            We appreciate your interest in joining our team. Our recruitment committee 
            carefully reviews every candidate to ensure we find the best fit for our 
            students and our community.
        </p>

        <div class="ref-container">
            <span class="ref-label">Reference Number</span>
            <div class="ref-value">@ViewBag.ReferenceNum</div>
        </div>

        <div class="next-steps">
            <h3>What happens next?</h3>
            <ul>
                <li><span class="dot orange"></span> Our HR team will review your application.</li>
                <li><span class="dot red"></span> Only shortlisted applicants will be contacted for an interview</li>
                <li><span class="dot orange"></span> Keep your reference number handy for any follow-up queries.</li>
            </ul>
        </div>

        <div class="action-row">
            <a href="/Home/HomePage" class="btn-glow">Go Home</a>
        </div>
        
    </div>
</div>

<style>

   
    .viewport {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background: url('/images/your-background.jpg') no-repeat center center fixed;
        background-size: cover;
        font-family: 'Satoshi', sans-serif;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        width: 100%;
        max-width: 700px;
        padding: 60px 40px;
        border-radius: 40px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.05);
        text-align: center;
        border: 1px solid rgba(255, 255, 255, 0.8);
    }

    .icon-sphere {
        width: 80px;
        height: 80px;
        background: #E34234;
        margin: 0 auto 20px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 15px 35px rgba(230, 57, 70, 0.3);
    }

    .icon-sphere svg {
        width: 35px;
        height: 35px;
    }

    .heading {
        font-family:Elephant;
        font-size: 36px;
        font-weight: 800;
        color: #1d1d1f;
        margin-bottom: 5px;
        letter-spacing: -1px;
    }

    .sub-heading {
    font-size: 16px;
    color: #D4543A;
    font-weight: 700;
    margin-bottom: 20px;
   }

    .interest-text {
        font-size: 15px;
        color: #636366;
        line-height: 1.6;
        max-width: 85%;
        margin: 0 auto 30px;
    }

    .ref-container {
        background: #fff;
        padding: 20px;
        border-radius: 20px;
        display: inline-block;
        min-width: 280px;
        border: 1px solid #f2f2f7;
        margin-bottom: 40px;
    }

    .ref-label {
        display: block;
        font-size: 11px;
        text-transform: uppercase;
        color: #86868b;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 4px;
    }

    .ref-value {
        font-size: 28px;
        font-weight: 900;
        color: #1d1d1f;
    }

    .next-steps {
        text-align: left;
        background: rgba(255, 255, 255, 0.5);
        padding: 25px;
        border-radius: 24px;
        margin-bottom: 40px;
        border: 1px solid rgba(0,0,0,0.03);
    }

    .next-steps h3 {
        font-size: 16px;
        font-weight: 700;
        margin-top: 0;
        margin-bottom: 15px;
        color: #1d1d1f;
    }

    .next-steps ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .next-steps li {
        font-size: 14px;
        color: #48484a;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .dot.orange { background-color: orangered; }
    .dot.red { background-color: indianred; }

    .btn-glow {
        display: inline-block;
        background:#E34234;
        color: white;
        text-decoration: none;
        padding: 16px 50px;
        border-radius: 15px;
        font-weight: 700;
        font-size: 16px;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(255, 140, 0, 0.2);
    }

    .btn-glow:hover {
        transform: scale(1.03);
        box-shadow: 0 15px 40px rgba(230, 57, 70, 0.3);
        color: white;
    }

    @@media (max-width: 600px) {
        .glass-card {
            padding: 40px 20px;
        }
        .heading { font-size: 28px; }
        .interest-text { font-size: 14px; }
    }

    body{
        background-image: url('/Images/ApplicationSubmittedImages/SubmittedBG1.jpeg');
        background-repeat: no-repeat;
        background-size: cover;
    }
  

</style>