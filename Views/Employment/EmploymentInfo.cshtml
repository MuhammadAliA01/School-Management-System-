<head>
    <style>
        .mainContainer{
            display:flex;
        }



        .texts{
            display:flex;
            flex-direction:column;
            justify-content:end;
            height: 50vh;
            margin-left:100px;
            gap:25px;
        }

        .content{
            display:flex;
            flex-direction:column;
        }

        .mainHeading{
            font-family:Dubai;
            font-weight:500;
            font-size:40px;
            

        }

        p{
            font-family:Dubai;
            font-size:20px;
        }

        .buttons{
            display:flex;
            margin-left: 100px;
            gap: 15px;
        }

        .button{
            text-align: center;
            display: flex;
            background-color: #ff4500;
            justify-content: center;
            color: white;
            width: 100px;
            height: 80px;
            border-radius: 25px;
            border: none;
            font-size: 15px;
            align-items:center
        }

        .button2 {
            text-align: center;
            display: flex;
            border: 2px solid #ff4500;
            align-items: center;
            background-color:white;
            justify-content: center;
            color: #ff4500;
            width: 230px;
            height: 80px;
            border-radius: 25px;
            font-size: 15px;
        }

        .button:hover {
            text-align: center;
            display: flex;
            background-color: #ff4500;
            justify-content: center;
            color: white;
            width: 100px;
            height: 80px;
            border-radius: 25px;
            border: none;
            font-size: 15px;
            align-items: center;
            transform: scale(1.1);
            transition: ease 0.2s all;
        }

        .button:active {
            text-align: center;
            display: flex;
            background-color: #ff4500;
            justify-content: center;
            color: white;
            width: 100px;
            height: 80px;
            border-radius: 25px;
            border: none;
            font-size: 15px;
            align-items: center
        }

        .button:focus-within {
            text-align: center;
            display: flex;
            background-color: #ff4500;
            justify-content: center;
            color: white;
            width: 100px;
            height: 80px;
            border-radius: 25px;
            border: none;
            font-size: 15px;
            align-items: center
        }

        .button2:hover {
            
            border-color: #ff4500;
            background-color:white;
            color: #ff4500;
            transform: scale(1.1);
            transition: ease 0.2s all;
        }

        .button2:active {
            border-color: #ff4500;
            background-color: white;
            color: #ff4500;
        }

        .button2:focus-within {
            border-color: #ff4500;
            background-color: white;
            color: #ff4500;
        }

        .imgDiv{
            margin-left: auto;
            margin-right: 150px;
        }

        .image{
            width:800px;
            height:800px;
            
        }

        @@media screen and (max-width: 950px) {
            .mainContainer{
                flex-direction:column;
            }

            .mainHeading{
                text-align:center;
            }

            p{
                text-align:center;
            }

            .buttons{
                justify-content:center;
            }

            .imgDiv {
                display:none;
                
            }

            

            .texts{
                margin-left: 0;
                height:50vh;
            }

            .buttons{
                margin-left: 0;
                order 3
            }
        
        }


    </style>
</head>

<body>
    <div class="mainContainer">
    <div class="content">
            <div class="texts">
                <h1 class="mainHeading">Looking for a job? We're hiring!</h1>

                <p>Fill out a job application here!</p>
            </div>

            <div class="buttons">
                <a class="btn btn-primary button" asp-action="SubmitApplication">Apply!</a>


                <a class="btn btn-primary button2" asp-action="SearchStatus">Already submitted an application? View status here!</a>
            </div>
    </div>
        

        <div class="imgDiv">
            <img class="image"src="/Images/EmploymentInfoImages/DemoImage.png" />
        </div>
    </div>

    
    
</body>




