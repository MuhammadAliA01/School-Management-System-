<head>

    <style>

        body{
        }


        .mainContent{
            background-color: #07a4b5;
            display:flex;
            justify-content:center;
            align-items:center;
            height:500px;
            background-image: url(/Images/SearchStatusImages/BGImage.jpg?6);
            background-size:cover;
        }

        h1{
            font-family:Dubai;
            color:white;
            font-size:50px;
            font-weight:500;

        }

        .otherDiv{
            display:flex;
            flex-direction:column;
        }

        .form{
            
        }

        .searchBar{
            width:620px;
            height: 50px;
            border-radius:10px;
            border:none;
            background-image: url(/Images/SearchStatusImages/Searchicon.png);
            background-size:60px;
            background-position:left;
            background-repeat:no-repeat;
            padding-left:50px;
            box-shadow: 0 -5px 5px rgba(0, 0, 0, 0.1), -5px 0 5px rgba(0, 0, 0, 0.1), 0 5px 5px rgba(0, 0, 0, 0.1);
        }

             

        .button{
            height:50px
        }

        @@media screen and (max-width: 950px) {
            .searchBar {
                width: 400px;
                height: 50px;
                
            }

            .otherDiv {
                display: flex;
                flex-direction: column;
                align-items:center;
                text-align:center;
            }

            .mainContent {
                background-position:right;
                background-size:300px;
                background-size:cover;
            }

            
        }


   
    </style>
</head>

<body>

    <div class="mainContent">

        <div class="otherDiv">
            <h1>Check Your Application Status</h1>


                <form method="get" class="form">

                    <input type="search" placeholder="  Enter your reference number" name="searchString" class="searchBar"/>
                <!--<button type="submit" class="button">Search</button>-->

                    <h1>@ViewBag.Status</h1>


                </form>

            
        </div>
       

    </div>


    

</body>




