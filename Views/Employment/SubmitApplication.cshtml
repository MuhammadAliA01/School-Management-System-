@model SchoolManagmentSystem.Models.EmploymentApplication

@{
    ViewData["Title"] = "Submit Application";
}

@{
    var Vacancy = new List<SelectListItem>
    {
        new SelectListItem { Value = "Teacher", Text = "Teacher" },
      new SelectListItem { Value = "Cleaner", Text = "Cleaner" }
    };


}


<head>

    <style>

        .headings{
            font-family:Dubai;
            text-align:center;
        }

        h1{
            font-family:Dubai;
        }

        p{
            font-family:Dubai;
        }

        .mainContainer{
            display: flex;
            justify-content: center;

        }

        .bottomContent{
            display:flex;
            justify-content:center;
            width: 700px;
            height: 550px;
            box-shadow: 0 -5px 5px rgba(0, 0, 0, 0.1), 5px 0 5px rgba(0, 0, 0, 0.1), 0 5px 5px rgba(0, 0, 0, 0.1);
            
            
        }

        .names{
            display:flex;
            gap: 30px;
        }

        .form-group{
            padding-top:30px
        }

        .customTextBox {
            border: none;
            outline: none;
            box-shadow: none;
            border-radius: 0;
            border-bottom: 1px solid black;
            width: 300px
        }

            .customTextBox:focus {
                box-shadow: none;
                border-bottom: 1px solid red;
            }

        .customDropdown{
            width: 100%;
            height: 37px;
            border: 1px solid grey;
            background-color:transparent;
            box-shadow:none;
            outline: none;
            border-radius: 5px;
        }

            .customDropdown:hover{
                cursor:pointer;
            }

            .customDropdown:focus{
                border-color:red;
            }
    
        .fileUpload{
            display:flex;
            outline: none;
            box-shadow: none;
            justify-content:center;
            border-radius:5px;
            align-items:center;
            width:100%;
            height: 100px;
            border: 1px dashed grey;
        }

            .fileUpload:hover{
                cursor:pointer;
                transform: scale(1.05);
                transition: ease 0.1s all;
                border-color: red;
            }

            

        .fileUpload input{
            display:none;
        }

        .fileUpload span{
            font-family:Dubai;
            font-size:20px;
        }

        .buttons {
            text-align: center;
        }

        .button {
            text-align: center;
            background-color: #f93a5b;
            color: white;
            width: 270px;
            height: 60px;
            border-radius: 25px;
            border: none;
            font-size: 25px;
        }

            .button:hover {
                text-align: center;
                background-color: #f93a5b;
                color: white;
                border-radius: 25px;
                border: none;
                font-size: 25px;
                transform: scale(1.1);
                transition: ease 0.2s all;
            }

            .button:active {
                text-align: center;
                background-color: #f93a5b;
                color: white;
                width: 270px;
                height: 60px;
                border-radius: 25px;
                border: none;
                font-size: 25px;
            }

            .button:focus-within {
                text-align: center;
                background-color: #f93a5b;
                color: white;
                width: 270px;
                height: 60px;
                border-radius: 25px;
                border: none;
                font-size: 25px;
            }

        @@media screen and (max-width: 950px) {

            .mainContainer {
                flex-direction:column;
            }

            .names {
                flex-direction:column;
                gap: 0;
            }
        }

    </style>

</head>



<body>
    <div class="headings">
        <h1>Job Application Form</h1>
        <p>Please fill in the form to apply for a position at HLA</p>
    </div>
    


    <div class="row mainContainer"> 
        <div class="bottomContent">
            <form asp-action="SubmitApplication" method="post" enctype="multipart/form-data">


                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="names">
                    <div class="form-group">
                        <input asp-for="FirstName" class="form-control customTextBox" placeholder="First Name" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <input asp-for="LastName" class="form-control customTextBox" placeholder="Last Name" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>
               
                <div class="form-group">
                    <input asp-for="Email" class="form-control customTextBox" placeholder="Email" style="width:100%" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="selectedRole"></label>
                    <select asp-for="selectedRole" asp-items="Vacancy" class="customDropdown"></select>
                    <span asp-validation-for="selectedRole" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label>Attach your CV/Resume</label>
                    <label class="fileUpload">
                        <input asp-for="CVLocation" class="form-control" type="file" name="cvFile" accept="application/pdf" placeholder="Upload CV File" />
                        <span>Choose File</span>
                    </label>

                    
                    <span asp-validation-for="CVLocation" class="text-danger"></span>
                </div>
                
                <div class="form-group buttons">
                    <input type="submit" value="Submit" class="btn btn-primary button" />
                </div>
            </form>
        </div>
    </div>
</body>




@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


