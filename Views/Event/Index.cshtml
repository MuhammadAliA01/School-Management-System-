@model IEnumerable<SchoolManagmentSystem.Models.EventCalendar>

@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container mt-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="border-left: 5px solid #198754 !important;">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
                <div>
                    <strong>Success!</strong> @TempData["SuccessMessage"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <h2 class="mb-4 text-primary fw-bold">Upcoming School & Therapy Events</h2>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-light">
                    <div class="card-header bg-primary text-white py-3">
                        <h5 class="card-title mb-0">@item.Title</h5>
                    </div>

                    <div class="card-body">
                        <p class="card-text text-muted">@item.Desc</p>
                        <hr />
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2">
                                <i class="bi bi-calendar3 me-2 text-primary"></i>
                                <strong>Start:</strong> @item.StartTime.ToString("dddd, dd MMM yyyy HH:mm")
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-calendar3-range me-2 text-primary"></i>
                                <strong>End:</strong> @item.EndTime.ToString("dddd, dd MMM yyyy HH:mm")
                            </li>
                            <li>
                                <i class="bi bi-people-fill me-2 text-primary"></i>
                                <strong>Confirmed Attendees:</strong>
                                <span class="badge bg-info text-dark ms-1">@item.AttendeeCount</span>
                            </li>
                        </ul>
                    </div>

                    <div class="card-footer bg-white border-top-0 pb-4">
                        <a asp-controller="Event" asp-action="Purchase" asp-route-id="@item.Id" class="btn btn-success btn-lg w-100 fw-bold shadow-sm">
                            Get Tickets
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        setTimeout(function () {
            let alert = document.querySelector(".alert");
            if (alert) {
                let bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            }
        }, 8000);
    </script>
}