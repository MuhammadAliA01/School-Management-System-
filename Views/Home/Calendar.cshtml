<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>School Calendar</title>
    <style>
        :root {
            --primary-orange: #FF5722; 
            --primary-blue: #0D6EFD; 
            --bg-cream: #FFFAF0;
        }

        body {
            background-image: url(/Images/CalenderImage/background.png);
            background-repeat: no-repeat;
            background-size: cover;
        }

        

        h1.page-title {
            text-align: center;
            color: var(--primary-orange);
            font-size: 3rem;
            margin-bottom: 5px;
            font-weight: 800;
        }

        p.subtitle {
            text-align: center;
            margin-bottom: 40px;
            font-size: 1.1rem;
        }

        .main-wrapper {
            display: flex;
            flex-direction: row;
            gap: 40px;
            align-items: flex-start;
            flex-wrap: wrap;
            justify-content: center;
            max-width: 1200px;
            margin: 0 auto;
        }

        /* Calendar Styling */
        .calendar-container {
            width: 450px;
            background: white;
            border-radius: 0; /* Square edges like the form */
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(0,0,0,0.05);
            border: 1px solid #eee;
        }

        .calendar-header {
            background-color: white;
            color: var(--primary-orange);
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #eee;
        }

        #monthDisplay {
            margin: 0;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .nav-btn {
            background: var(--primary-blue);
            border: none;
            color: white;
            padding: 8px 18px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            transition: opacity 0.2s;
        }

            .nav-btn:hover {
                opacity: 0.8;
            }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            color: var(--primary-orange);
            padding: 15px 5px;
            font-size: 0.9rem;
            border-bottom: 1px solid #eee;
        }

        td {
            padding: 20px;
            text-align: center;
            border: 1px solid #f9f9f9;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s;
        }

            td:hover:not(.empty) {
                background-color: #f0f7ff;
                color: var(--primary-blue);
            }

        .today {
            color: var(--primary-orange);
            text-decoration: underline;
            font-weight: 900;
        }

        .selected {
            background-color: var(--primary-blue) !important;
            color: white !important;
        }

        .has-event::after {
            content: '';
            display: block;
            margin: 2px auto 0;
            width: 6px;
            height: 6px;
            background: var(--primary-orange);
            border-radius: 50%;
        }

        /* Event Details Styling - Matches the "Send Message" box */
        .event-details {
            width: 350px;
            padding: 30px;
            background: white;
            border: 4px dotted #000; /* Dotted border from your image */
            min-height: 250px;
        }

            .event-details h3 {
                margin-top: 0;
                color: #000;
                font-size: 1.5rem;
                font-weight: 800;
                margin-bottom: 15px;
            }

        #eventDescription {
            line-height: 1.6;
            color: #555;
            font-size: 1rem;
        }

        /* Decorative Elements */
        .decoration {
            position: fixed;
            z-index: -1;
            opacity: 0.8;
        }
    </style>
</head>
<body>

    <h1 class="page-title">School Calendar</h1>
    <p class="subtitle">Stay updated with our latest events and activities</p>

    <div class="main-wrapper">
        <div class="calendar-container">
            <div class="calendar-header">
                <button class="nav-btn" id="prevMonth">&lt;</button>
                <h2 id="monthDisplay"></h2>
                <button class="nav-btn" id="nextMonth">&gt;</button>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Sun</th>
                        <th>Mon</th>
                        <th>Tue</th>
                        <th>Wed</th>
                        <th>Thu</th>
                        <th>Fri</th>
                        <th>Sat</th>
                    </tr>
                </thead>
                <tbody id="calendarBody"></tbody>
            </table>
        </div>

        <div class="event-details" id="eventDetails">
            <h3 id="selectedDateText">Event Details</h3>
            <p id="eventDescription">Select a highlighted date on the calendar to view school event information.</p>
        </div>
    </div>

    <script>
        const monthDisplay = document.getElementById('monthDisplay');
        const calendarBody = document.getElementById('calendarBody');
        const prevBtn = document.getElementById('prevMonth');
        const nextBtn = document.getElementById('nextMonth');
        const selectedDateText = document.getElementById('selectedDateText');
        const eventDescription = document.getElementById('eventDescription');

        const events = {
            "2026-04-28": "The Inclusive Obstacle Odyssey: A sports day focusing on individual progress with tactile balance beams and quiet tunnels.",
            "2026-04-30": "Community Life-Skills Pop-Up Café: Students practice social scripts and vocational skills serving the community.",
            "2026-05-01": "Low-Sensory Creative Showcase: A calm art environment with soft lighting and noise-reduction zones."
        };

        const today = new Date();
        let navDate = new Date(today.getFullYear(), today.getMonth(), 1);

        function renderCalendar(date) {
            const year = date.getFullYear();
            const month = date.getMonth();

            monthDisplay.innerText = `${date.toLocaleString('default', { month: 'long' })} ${year}`;
            calendarBody.innerHTML = '';

            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();

            let dateCounter = 1;

            for (let i = 0; i < 6; i++) {
                let row = document.createElement('tr');
                for (let j = 0; j < 7; j++) {
                    let cell = document.createElement('td');
                    if (i === 0 && j < firstDay) {
                        cell.classList.add('empty');
                    } else if (dateCounter > daysInMonth) {
                        // Skip
                    } else {
                        const currentDay = dateCounter;
                        cell.innerText = currentDay;
                        const dateKey = `${year}-${String(month + 1).padStart(2, '0')}-${String(currentDay).padStart(2, '0')}`;

                        if (events[dateKey]) cell.classList.add('has-event');
                        if (currentDay === today.getDate() && month === today.getMonth() && year === today.getFullYear()) {
                            cell.classList.add('today');
                        }

                        cell.addEventListener('click', () => {
                            document.querySelectorAll('td').forEach(td => td.classList.remove('selected'));
                            cell.classList.add('selected');
                            showEvent(year, month, currentDay);
                        });
                        dateCounter++;
                    }
                    row.appendChild(cell);
                }
                calendarBody.appendChild(row);
                if (dateCounter > daysInMonth) break;
            }
        }

        function showEvent(year, month, day) {
            const dateKey = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
            const dateString = new Date(year, month, day).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

            selectedDateText.innerText = dateString;
            eventDescription.innerText = events[dateKey] || "No specific events scheduled for this day.";
        }

        prevBtn.addEventListener('click', () => {
            navDate.setMonth(navDate.getMonth() - 1);
            renderCalendar(navDate);
        });

        nextBtn.addEventListener('click', () => {
            navDate.setMonth(navDate.getMonth() + 1);
            renderCalendar(navDate);
        });

        renderCalendar(navDate);
    </script>
</body>
</html>