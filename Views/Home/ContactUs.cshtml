<head>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">


    <style>
        .heading1{
            color: orangered;
            font-size: 60px;
            font-family:Arial;
            font-weight: 700;
            font-style: normal;
            font-weight:900;
            padding-top: 50px;
        }

        .paragraph{
            font-size:25px;
            font-family:Arial;
            font-weight: 500;
            font-style: normal;
            padding-top: 10px;
        }

        .Text{
            text-align:center;
     
        }

        .icons{
            width:80px;
            height:80px;
        }

        .heading2{
            color: orangered;
            font-family: Arial black;
            color: #ff5a1f;
            margin: 0;
        }

        .Content{
            display:flex;
            align-items: flex-start;
            gap: 20px;
            font-size: 20px;
            
        }

        .Content p {
            margin: 5px 0 0 0;
         }

        .Content i {
            font-size: 22px;
            color: black;
            margin-top: 5px;
          
        }



        .bottomContent{
            display:flex;
            padding:200px;
            padding-top:70px;
        }

        .messageBox{
            display:flex;
            flex-direction: column;
            gap:25px;
            background-color:white;
            border:5px black;
            border-style:dotted;
            height:325px;
            width:460px;
            padding:10px;
            margin-left: auto;
            font-family:'Palatino Linotype';
            
        
        }

        .boxHeading{
            font-family:Arial black;
            font-size:27px;
            font-weight:700;
        }

        body{
            background-image: url(/Images/ContactImages/BackgroundImage5.jpg);
            background-repeat:no-repeat;
            background-size:cover;
            
        }

       


    </style>



</head>

<body>
    <div class="Text"> 
        <h1 class="heading1"> Contact Us</h1>
        <p class="paragraph">
            Reach out with any questions or concerns
        </p>
    </div>

    <div class="bottomContent">
        <div class="ContactInfo">
            <div class="Content">
                <div class="AddressIcon">
                    <div class="AddressIcon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                </div>
                <div class="AddressText">
                    <h4 class="heading2">Address</h4>
                    <p>51 Tourmalin Ave,<br /> Chatsworth, Durban<br /> 4092</p>
                </div>
            </div>

            <div class="Content mt-5">
                <div class="PhoneIcon">
                    <div class="PhoneIcon">
                        <i class="fas fa-phone"></i>
                    </div>
                </div>
                <div class="PhoneText">
                    <h4 class="heading2">Phone</h4>
                    <p>065 362 9055</p>
                </div>
            </div>

            <div class="Content mt-5">
                <div class="EmailIcon">
                    <div class="EmailIcon">
                        <i class="fas fa-envelope"></i>
                    </div>
                </div>
                <div class="EmailText">
                    <h4 class="heading2">Email</h4>
                    <p>joelene.nadasan@gmail.com</p>
                </div>
            </div>

        </div>
        <div class="messageBox">

            <h3 class="boxHeading">Send Message</h3>
            <input type="text" placeholder="Full Name"/>
            <input type="text" placeholder="Email" />
            <textarea placeholder="Type Your Message"></textarea>
            <button class="btn-primary">Send</button>
        </div>
        
    </div>

 
</body>