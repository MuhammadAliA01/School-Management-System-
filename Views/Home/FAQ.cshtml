@model IEnumerable<SchoolManagmentSystem.Models.FAQ_Model>


<br />
<h3>Frequently Asked Questions</h3>
<br />
<div class="accordion" id="faqAccordion">
    @{
        int i = 0;
    }
 @* 1. Start a counter *@
    @foreach (var item in Model)
    {
        <div class="accordion-item">
            <h2 class="accordion-header">
                @* 2. Ensure data-bs-target includes the unique number *@
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse-@i">
                    @item.Questions
                </button>
            </h2>
            @* 3. Ensure this ID matches the target above exactly *@
            <div id="collapse-@i" class="accordion-collapse collapse"
                 data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    @item.Answers @* If this is empty, your data isn't loading! *@
                </div>
            </div>
        </div>
        i++;


        @* 4. Increment for the next item *@
    }
</div>
