<html>

<head>
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/5/w3.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Just+Another+Hand&family=Mona+Sans:ital,wght@0,200..900;1,200..900&family=Roboto:ital,wght@0,100..900;1,100..900&family=Underdog&family=Winky+Rough:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bpmf+Huninn&family=Just+Another+Hand&family=Mona+Sans:ital,wght@0,200..900;1,200..900&family=Playpen+Sans+Thai:wght@100..800&family=Roboto:ital,wght@0,100..900;1,100..900&family=Underdog&family=Winky+Rough:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">

    <style>

        body{
            background-image: url("/Images/GalleryImages/GalleryBG1.jpg");
            background-size: cover;
            background-position: center center;
        }

        .gallery{
            display: grid;
            justify-content: center;
            gap: 20px;
            grid-template-columns: 400px 400px 400px;


        }

        .images{
           width: 380px;
            margin: 20px;
            height: 250px;
            object-fit: cover;
            border: 3px dashed black;
            border-radius: 20px;
        }

        .imagesModal{
           display:flex;
            justify-content: center;
            margin: 0 auto;
            margin-top:-3%;
            border-radius: 20px;
            border: 10px double white;
            width: 700px;
            height: 850px;
            

        }

        
        

        .images:hover{
                transform: scale(1.1);
                transition: all 0.2s ease;
                cursor:pointer;
                
            }



        .Heading{
            font-family:bpmf huninn;
            text-align: center;
            font-weight:bold;
            font-size: 60px;
            color: orangered;
        }



        @@media screen and (max-width: 950px){

            .gallery {
                display: flex;
                flex-direction: column;
            }


            

            .imagesModal {
                display: flex;
                justify-content: center;
                margin: 0 auto;
                width: 400px;
                height: 550px;
            }

        }




    </style>



</head>

<body>

    <h1 class="Heading">Gallery</h1>

    <div class="gallery ">
        <img src="/Images/GalleryImages/GalleryPic.png" class="images w3-hover-opacity" onclick="document.getElementById('image01').style.display='block'"/>
        <img src="/Images/GalleryImages/GalleryPic2.png" class="images w3-hover-opacity" onclick="document.getElementById('image02').style.display='block'" />
        <img src="/Images/GalleryImages/GalleryPic3.png" class="images w3-hover-opacity" onclick="document.getElementById('image03').style.display='block'" />
        <img src="/Images/GalleryImages/GalleryPic4.png" class="images w3-hover-opacity" onclick="document.getElementById('image04').style.display='block'" />
        <img src="/Images/GalleryImages/GalleryPic5.png" class="images w3-hover-opacity" onclick="document.getElementById('image05').style.display='block'" />
        <img src="/Images/GalleryImages/GalleryPic6.png" class="images w3-hover-opacity" onclick="document.getElementById('image06').style.display='block'" />




    </div>

    <div class="w3-modal w3-animate-zoom" id="image01" onclick="document.getElementById('image01').style.display='none'">
            

        <img src="/Images/GalleryImages/GalleryPic.png" class="imagesModal" />
      


    </div>


    <div class="w3-modal w3-animate-zoom align-items-center" id="image02" onclick="document.getElementById('image02').style.display='none'">


        <img src="/Images/GalleryImages/GalleryPic2.png" class="imagesModal" />



    </div>

    <div class="w3-modal w3-animate-zoom align-items-center" id="image03" onclick="document.getElementById('image03').style.display='none'">


        <img src="/Images/GalleryImages/GalleryPic3.png" class="imagesModal" />



    </div>

    <div class="w3-modal w3-animate-zoom align-items-center" id="image04" onclick="document.getElementById('image04').style.display='none'">


        <img src="/Images/GalleryImages/GalleryPic4.png" class="imagesModal" />



    </div>

    <div class="w3-modal w3-animate-zoom align-items-center" id="image05" onclick="document.getElementById('image05').style.display='none'">


        <img src="/Images/GalleryImages/GalleryPic5.png" class="imagesModal" />



    </div>

    <div class="w3-modal w3-animate-zoom align-items-center" id="image06" onclick="document.getElementById('image06').style.display='none'">


        <img src="/Images/GalleryImages/GalleryPic6.png" class="imagesModal" />



    </div>

    






</body>



</html>
