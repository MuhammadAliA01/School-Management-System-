<head>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Just+Another+Hand&family=Mona+Sans:ital,wght@0,200..900;1,200..900&family=Roboto:ital,wght@0,100..900;1,100..900&family=Underdog&family=Winky+Rough:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bpmf+Huninn&family=Just+Another+Hand&family=Mona+Sans:ital,wght@0,200..900;1,200..900&family=Playpen+Sans+Thai:wght@100..800&family=Roboto:ital,wght@0,100..900;1,100..900&family=Underdog&family=Winky+Rough:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
    <style>



        .topBar{
        display: flex;
        height: 500px;
        background-image: url("/Images/HomeImages/PaperBG6.jpg");
        background-size: cover;
        background-position: bottom center;
        

        }

        .BottomContent{
            display: flex;
            justify-content: center;
           background-size: cover;
        background-repeat: no-repeat;
        background-position: center center;
         background-color: rgba(255, 255, 255, 0.6);
        background-blend-mode: lighten;
        }

        .Gallery {
                display: flex;
                justify-content: center;
                gap: 100px;

            }


            .pic1{

            border-radius: 20px;

        }

        .pic2{

        border-radius: 20px;
        }

        .pic3{

        border-radius: 20px;
        }

        .heading{


        margin: auto 0;
        margin-left: 5%;
        font-size: 50px;
        letter-spacing: 5px;
        font-family: bpmf huninn;}

        .heading2{
            margin: auto 0;
        margin-left: 5%;
        font-size: 50px;
        letter-spacing: 5px;
        font-family: bpmf huninn;
        color: orangered;
        }


        .text{
            text-align: left;
            margin: auto 0;
            margin-left: 5%;
            width: 700px;

        }

        .topBarImg{

        margin-left: auto;
        margin-right: 5%;

        }


        .headingP{


        margin-right: auto 0;
        margin-left: 5%;
        font-family: bpmf huninn;

        }

        .btn{

            margin-top: 3%;
        margin-left: 5%;
        height: 40px;
        width: 150px;
        border-radius: 30px;
        background-color: orangered;
        color: white;
        border-color: white;
        border-style: dashed;
        transition: all 0.1s ease;
        font-family: bpmf huninn;

        }

        .btn:hover{
            transform: scale(1.2);
            cursor: pointer;
        }

        .bottomP{
            font-family: bpmf huninn;
            font-size: 30px;
            text-align: center;
            width: 900px;
            line-height: 1.8;
        font-weight: bold;






        }


        @@media screen and (max-width: 950px) {
            .topBar {
                flex-direction: column;
                height: auto;
                justify-content: center;
            }

            .text {
                margin: 20px;
                width: auto;
                text-align: center;
            }

            .heading {
                font-size: 30px;
                font-family: 'Courier New', Courier, monospace;
            }
            .heading2 {
                font-size: 30px;
                font-family: 'Courier New', Courier, monospace;
            }

            .topBarImg {
                max-width: 300px;
                max-height: 300px;
                width: 100%;
                height: 100%;
                margin: auto;
            }



            .btn {
                margin: 20px auto;
                width: 120px;
                height: 50px;
            }

            .bottomP {
                width: 90%;
                font-size: 20px;
                ;
            }


            .Gallery{

                flex-direction: column;
                }

            .pic1{


                max-width: 300px;
                max-height: 300px;
                width: 150px;
                height: 200px;
                margin: auto;
            }

            .pic2{

                 max-width: 300px;
                max-height: 300px;
                width: 150px;
                height: 200px;
                margin: auto;
            }

            .pic3{

                max-width: 300px;
                max-height: 300px;
                width: 150px;
                height: 200px;
                margin: auto;
            }

        }

    </style>

</head>

<body>

    <div class="topBar">
        <div class="text">
            <h1 class="heading">A Wonderful Start For</h1>
            <h1 class="heading2">Growing Little Minds!</h1>
            <p class="headingP">Where learning is fun engaging and inspiring!</p>
            <button class="btn">Enroll Now -></button>
        </div>

        <img class="topBarImg" src="/Images/HomeImages/topBarImg.png">




    </div>

    <div class="BottomContent">
        <div class="textbottom">
            <p class="bottomP">
                We Create A Safe, Joyful Space Where Children Can Explore, Learn, And Grow Together. Our Dedicated Team Of Educators Is Committed To Fostering A Love For Learning Through Play-Based Activities, Creative Arts, And Social Interaction. Join Us In Building A Strong Foundation For Your Child's Future!



            </p>
        </div>

    </div>

    <div class="Gallery">

        <img src="/Images/HomeImages/gPic1.png" class="pic1">
        <img src="/Images/HomeImages/gPic2.png" class="pic2">
        <img src="/Images/HomeImages/gPic3.png" class="pic3">


    </div>


</body>