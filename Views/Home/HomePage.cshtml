<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Just+Another+Hand&family=Mona+Sans:ital,wght@0,200..900;1,200..900&family=Roboto:ital,wght@0,100..900;1,100..900&family=Underdog&family=Winky+Rough:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bpmf+Huninn&family=Just+Another+Hand&family=Mona+Sans:ital,wght@0,200..900;1,200..900&family=Playpen+Sans+Thai:wght@100..800&family=Roboto:ital,wght@0,100..900;1,100..900&family=Underdog&family=Winky+Rough:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
    <style>



        .topBar{
        display: flex;
        height: 500px;
        background-image: url("/Images/HomeImages/PaperBG6.jpg");
        background-size: cover;
        background-position: bottom center;
        

        }

        .BottomContent{
            display: flex;
            justify-content: center;
           background-size: cover;
        background-repeat: no-repeat;
        background-position: center center;
         background-color: rgba(255, 255, 255, 0.6);
        background-blend-mode: lighten;
        }

        #Gallery {
                display: flex;
                width: 1200px;
                margin: 0 auto;
            justify-content: center;


            }


            .pics{
                
                width:1200px;
                height:550px;
            border-radius: 20px;
        }

       


        .heading{


        margin: auto 0;
        margin-left: 5%;
        font-size: 50px;
        letter-spacing: 5px;
        font-family: bpmf huninn;}

        .heading2{
            margin: auto 0;
        margin-left: 5%;
        font-size: 50px;
        letter-spacing: 5px;
        font-family: bpmf huninn;
        color: orangered;
        }


        .text{
            text-align: left;
            margin: auto 0;
            margin-left: 5%;
            width: 700px;

        }

        .topBarImg{

        margin-left: auto;
        margin-right: 5%;

        }


        .headingP{


        margin-right: auto 0;
        margin-left: 5%;
        font-family: bpmf huninn;

        }

        .btn{

            margin-top: 3%;
        margin-left: 5%;
        height: 40px;
        width: 150px;
        border-radius: 30px;
        background-color: orangered;
        color: white;
        border-color: white;
        border-style: dashed;
        transition: all 0.1s ease;
        font-family: bpmf huninn;

        }

        .btn:hover{
            transform: scale(1.2);
            cursor: pointer;
                background-color: orangered;
                color: white;
                border-color: white;
                border-style: dashed;
            }

        .bottomP{
            font-family: bpmf huninn;
            font-size: 30px;
            text-align: center;
            width: 900px;
            line-height: 1.8;
        font-weight: bold;






        }


        @@media screen and (max-width: 950px) {
            .topBar {
                flex-direction: column;
                height: auto;
                justify-content: center;
            }

            .text {
                margin: 20px;
                width: auto;
                text-align: center;
            }

            .heading {
                font-size: 30px;
            }
            .heading2 {
                font-size: 30px;
            }

            .topBarImg {
                max-width: 300px;
                max-height: 300px;
                width: 100%;
                height: 100%;
                margin: auto;
            }



            .btn {
                margin: 20px auto;
                width: 120px;
                height: 50px;
            }

            .bottomP {
                width: 100%;
                font-size: 20px;
                
            }


            #Gallery{

               flex-direction: column;
            margin: 0 auto;
            width:400px;
                }

            .pics{


                max-width: 400px;
                max-height: 350px;
                width: 400px;
                height: 200px;
                margin: auto;
            }

           

        }

    </style>

</head>

<body>





    <div class="topBar">
        <div class="text">
            <h1 class="heading">A Bright Start For</h1>
            <h1 class="heading2">Growing Little Minds!</h1>
            <p class="headingP">Where learning is fun engaging and inspiring!</p>
            @if (User.Identity.IsAuthenticated)
            {
                <a class="btn" asp-action="ParentDashboard" asp-controller="Dashboards">Enroll Now -></a>
            }
            else
            {
                <a class="btn" asp-action="Login" asp-controller="Account">Enroll Now -></a>

            }
        </div>

        <img class="topBarImg" src="/Images/HomeImages/topBarImg.png">




    </div>

    <div class="BottomContent">
        <div class="textbottom">
            <p class="bottomP">
                We Create A Safe, Joyful Space Where Children Can Explore, Learn, And Grow Together. Our Dedicated Team Of Educators Is Committed To Fostering A Love For Learning Through Play-Based Activities, Creative Arts, And Social Interaction. Join Us In Building A Strong Foundation For Your Child's Future!



            </p>
        </div>

    </div>


   <div class="carousel slide" id="Gallery">
       <div class="carousel-inner">
           <div class="carousel-item active">
                <img src="/Images/HomeImages/galPic1.png" class="pics">

           </div>
            <div class="carousel-item">
                <img src="/Images/HomeImages/galPic2.png" class="pics">

            </div>
            <div class="carousel-item">
                <img src="/Images/HomeImages/galPic3.png" class="pics">

            </div>

            <button class="carousel-control-prev" data-bs-target="#Gallery" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" data-bs-target="#Gallery" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>

       </div>


   </div>

    


</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>