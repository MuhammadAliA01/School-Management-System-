@model SchoolManagmentSystem.Models.StudentRegistration

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register Child</title>
    <style>
        :root {
            --primary-color: #4a90e2;
            --bg-color: #f4f7f6;
            --text-color: #333;
            --success-color: #28a745;
            --error-color: #dc3545;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            width: 100%;
        }

        .form-container {
            background: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 600px;
            margin: auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #eee;
            margin-bottom: 20px;
            padding-bottom: 10px;
        }

        h2 {
            margin: 0;
            font-size: 1.5rem;
            text-transform: uppercase;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
            font-size: 0.85rem;
            text-transform: uppercase;
        }

            /* Red asterisk for required fields */
            label.required::after {
                content: " *";
                color: var(--error-color);
            }

        input, select, textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .address-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .full-width {
            grid-column: span 2;
        }

        .radio-group {
            display: flex;
            gap: 15px;
            margin-top: 5px;
        }

        .row {
            display: flex;
            gap: 15px;
        }

            .row > div {
                flex: 1;
            }

        .info-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #eee;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            font-size: 12px;
            font-weight: bold;
            cursor: pointer;
            border: none;
            margin-left: 5px;
        }

        .file-upload {
            border: 2px dashed var(--primary-color);
            padding: 20px;
            text-align: center;
            margin: 20px 0 5px 0;
            border-radius: 4px;
            cursor: pointer;
            background: #f0f7ff;
            transition: background 0.3s;
        }

            .file-upload.missing {
                border-color: var(--error-color);
                background: #fff5f5;
            }

        #file-list {
            margin-bottom: 20px;
            font-size: 0.9rem;
            font-weight: bold;
            display: none;
            padding: 10px;
            border-radius: 4px;
        }

        .file-success {
            background: #e8f5e9;
            color: var(--success-color);
            border: 1px solid #c8e6c9;
        }

        .file-error {
            background: #fdecea;
            color: var(--error-color);
            border: 1px solid #f5c6cb;
        }

        button[type="submit"] {
            width: 100%;
            padding: 14px;
            background-color: #222;
            color: white;
            border: none;
            border-radius: 4px;
            font-weight: bold;
            cursor: pointer;
            text-transform: uppercase;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
            z-index: 100;
        }

        .modal-content {
            background: white;
            padding: 20px;
            border-radius: 8px;
            max-width: 400px;
            position: relative;
        }

        .close-modal {
            position: absolute;
            top: 10px;
            right: 10px;
            cursor: pointer;
            font-size: 20px;
        }
    </style>
</head>
<body>

    <div class="form-container">
        <div class="header">
            <h2>Register Child</h2>
        </div>

        @* Redirects directly to the Confirmation page URL *@
        <form action="/Home/Confirmation" method="get">

            <input type="hidden" name="ParentId" value="1" />

            <div class="form-group">
                <label class="required">Parent/Guardian Full Name</label>
                <input name="ParentName" required />
            </div>

            <div class="row">
                <div class="form-group">
                    <label class="required">Email</label>
                    <input name="ParentEmail" type="email" required />
                </div>
                <div class="form-group">
                    <label class="required">Phone (Emergency)</label>
                    <input name="ParentPhone" type="tel" required />
                </div>
            </div>

            <label class="required">Address</label>
            <div class="address-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div class="form-group" style="grid-column: span 2;">
                    <input name="Street" placeholder="Street Name" required />
                </div>
                <div class="form-group"><input name="Suburb" placeholder="Suburb" required /></div>
                <div class="form-group"><input name="City" placeholder="City" required /></div>
                <div class="form-group"><input name="PostalCode" placeholder="Postal Code" required /></div>
            </div>

            <hr style="margin: 20px 0; border: 0; border-top: 1px solid #eee;">

            <div class="form-group">
                <label class="required">Child's Full Name</label>
                <input name="ChildName" required />
            </div>

            <div class="row">
                <div class="form-group">
                    <label class="required">Child's DOB</label>
                    <input name="ChildDob" id="ChildDob" type="date" required />
                    <span id="dobError" style="color: var(--error-color); font-size: 0.75rem; display: none;">
                        Child must be between 8 and 15 years old.
                    </span>
                </div>
                <div class="form-group">
                    <label class="required">Gender</label>
                    <div style="display:flex; gap:10px; padding-top:10px;">
                        <input type="radio" name="Gender" value="Male" required /> Male
                        <input type="radio" name="Gender" value="Female" /> Female
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="form-group">
                    <label class="required">Level of Autism<button type="button" class="info-btn" onclick="showInfo('level')">i</button></label>
                    <select name="AutismLevel" required>
                        <option value="">Select Level</option>
                        <option value="Level 1">Level 1</option>
                        <option value="Level 2">Level 2</option>
                        <option value="Level 3">Level 3</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="required">Type of Autism<button type="button" class="info-btn" onclick="showInfo('type')">i</button></label>
                    <select name="AutismType" required>
                        <option value="">Select Type</option>
                        <option value="Autistic Disorder">Autistic Disorder</option>
                        <option value="Asperger’s Syndrome">Asperger’s Syndrome</option>
                        <option value="PDD-NOS">PDD-NOS</option>
                        <option value="Childhood Disintegrative Disorder">Childhood Disintegrative Disorder</option>
                        <option value="Rett Syndrome">Rett Syndrome</option>
                    </select>
                </div>
            </div>

            <div class="file-upload" onclick="document.getElementById('fileInput').click()">
                <strong>CLICK TO UPLOAD EVALUATION (PDF) <span style="color:red">*</span></strong>
                <input type="file" id="fileInput" name="pdfFile" accept=".pdf" style="display:none" required>
            </div>

            <div class="form-group">
                <label>Additional Comments</label>
                <textarea name="Comments" rows="4"></textarea>
            </div>

            <button type="submit">Submit Registration</button>

           
        </form>

        
    </div>

    <div id="infoModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal()">&times;</span>
            <h3 id="modalTitle">Information</h3>
            <div id="modalBody"></div>
        </div>
    </div>

    <script>
        // 1. File Upload Logic (Existing)
        document.getElementById('fileInput').onchange = function () {
            const fileName = this.files[0] ? this.files[0].name : "CLICK TO UPLOAD EVALUATION (PDF)";
            document.querySelector('.file-upload strong').innerHTML =
                `SELECTED: ${fileName} <span style="color:red">*</span>`;
            document.querySelector('.file-upload').style.borderColor = "#28a745";
        };

        // 2. Date of Birth Validation Logic
        const dobInput = document.getElementById('ChildDob');
        const dobError = document.getElementById('dobError');
        const today = new Date();

        // Calculate dates
        // Max date (Youngest: 8 years ago)
        const maxDate = new Date(today.getFullYear() - 8, today.getMonth(), today.getDate());
        // Min date (Oldest: 15 years ago)
        const minDate = new Date(today.getFullYear() - 15, today.getMonth(), today.getDate());

        // Format to YYYY-MM-DD for the HTML input attributes
        const formatDate = (date) => date.toISOString().split('T')[0];

        // Set constraints on the input field
        dobInput.setAttribute('min', formatDate(minDate));
        dobInput.setAttribute('max', formatDate(maxDate));

        // Optional: Add a visual warning if they type/select an invalid date manually
        dobInput.addEventListener('change', function() {
            const selectedDate = new Date(this.value);
            if (selectedDate > maxDate || selectedDate < minDate) {
                dobError.style.display = 'block';
                this.style.borderColor = 'var(--error-color)';
            } else {
                dobError.style.display = 'none';
                this.style.borderColor = '#ccc';
            }
        });

        // Prevent form submission if DOB is invalid
        document.querySelector('form').onsubmit = function(e) {
            const selectedDate = new Date(dobInput.value);
            if (selectedDate > maxDate || selectedDate < minDate) {
                e.preventDefault();
                alert("The child must be between 8 and 15 years old to register.");
                dobInput.focus();
                return false;
            }
        };

            const infoData = {
            level: {
                title: "Autism Support Levels",
                content: "<ul><li><b>Level 1:</b> Requires support.</li><li><b>Level 2:</b> Requires substantial support.</li><li><b>Level 3:</b> Requires very substantial support.</li></ul>"
            },
            type: {
                title: "Types of Autism Spectrum",
                            content: "<ul><li><b>Autistic Disorder:</b> Significant delays.</li><li><b>Asperger’s Syndrome:</b> Milder symptoms.</li><li><b>PDD-NOS:</b> Atypical autism.</li><li><b>Childhood Disintegrative Disorder:</b> Late-onset regression.</li><li><b>Rett Syndrome:</b> Genetic motor/social decline.</li></ul>"
            }
        };


             function showInfo(category) {
            document.getElementById('modalTitle').innerText = infoData[category].title;
            document.getElementById('modalBody').innerHTML = infoData[category].content;
            document.getElementById('infoModal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('infoModal').style.display = 'none';
        }

        window.onclick = function (event) {
            if (event.target == document.getElementById('infoModal')) closeModal();
        }
    </script>
</body>
</html>