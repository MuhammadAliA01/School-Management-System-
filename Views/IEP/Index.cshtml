@model IEnumerable<SchoolManagmentSystem.Models.IEP>

@{
    ViewData["Title"] = "IEP Dashboard";
}

@section Styles {
    <style>
        :root {
            --school-orange: #FF6B35;
        }

        .page-title {
            font-weight: 800;
            color: #2d3436;
            letter-spacing: -1px;
        }

        .stats-banner {
            background: #f8f9fa;
            border-radius: 15px;
            border-left: 6px solid var(--school-orange);
        }

        .table-container {
            background: white;
            border-radius: 15px;
            overflow: hidden;
        }

        .thead-custom {
            background-color: #f1f3f5;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 1px;
            color: #636e72;
        }

        .student-name {
            color: var(--school-orange);
            font-weight: 600;
        }

        .btn-create {
            background-color: var(--school-orange);
            color: white;
            border-radius: 10px;
            transition: transform 0.2s, background-color 0.2s;
            border: none;
        }

            .btn-create:hover {
                background-color: #e55a2b;
                color: white;
                transform: translateY(-2px);
            }

        .goal-text {
            font-size: 0.9rem;
            color: #636e72;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(255, 107, 53, 0.03);
        }

        /* Aligning the action buttons */
        .action-wrapper {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }
    </style>
}

<div class="container py-4">
    <div class="row align-items-center mb-4">
        <div class="col-md-8 text-start">
            <h1 class="page-title mb-1">Individualized Education Programs</h1>
            <p class="text-muted">Tracking student progress and academic goals.</p>
        </div>
        <div class="col-md-4 text-md-end">
            <a asp-action="Create" class="btn btn-create px-4 py-2 shadow-sm">
                <i class="fas fa-plus-circle me-1"></i> Create New IEP
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center">
            <i class="fas fa-check-circle me-2"></i>
            <div>@TempData["Success"]</div>
        </div>
    }

    <div class="stats-banner p-3 mb-4 d-flex align-items-center shadow-sm">
        <div class="px-3">
            <span class="d-block text-muted small fw-bold">TOTAL PROGRAMS</span>
            <span class="h4 fw-bold mb-0">@Model.Count()</span>
        </div>
    </div>

    <div class="table-container shadow-sm border">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="thead-custom">
                    <tr>
                        <th class="ps-4 py-3">Student Name</th>
                        <th class="py-3">Term</th>
                        <th class="py-3">Target Date</th>
                        <th class="py-3">Academic Goals</th>
                        <th class="text-end pe-4 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="student-name">
                                    @(item.Student != null ? item.Student.FullName : "Student #" + item.StudentId)
                                </span>
                            </td>
                            <td>
                                <span class="badge rounded-pill bg-light text-dark border px-3">
                                    @item.Term
                                </span>
                            </td>
                            <td>
                                <div class="text-dark">@item.TargetDate.ToString("MMM dd, yyyy")</div>
                            </td>
                            <td>
                                <div class="goal-text text-truncate" style="max-width: 280px;" title="@item.AcademicGoals">
                                    @item.AcademicGoals
                                </div>
                            </td>
                            <td class="pe-4">
                                <div class="action-wrapper">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-bold">
                                        View Details
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this IEP?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fas fa-folder-open d-block mb-2 fa-2x"></i>
                                No IEP records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>