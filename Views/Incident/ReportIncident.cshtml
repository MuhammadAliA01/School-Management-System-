@model SchoolManagmentSystem.Models.Incident

@{
    ViewBag.Title = "New Incident Report";
}

<div class="container" style="margin-top: 20px;">
    <h2>Special Needs School - Incident Log</h2>
    <hr />

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label>Assigned Teacher</label>
            <select asp-for="TeacherId" id="TeacherId" class="form-control" asp-items="ViewBag.Teachers">
                <option value="">-- Select Teacher from Database --</option>
            </select>
            <span asp-validation-for="TeacherId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Student Name</label>
            <select asp-for="StudentName" id="StudentDropdown" class="form-control" required>
                <option value="">-- Select a Teacher First --</option>
            </select>
            <span asp-validation-for="StudentName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Date of Incident</label>
            <input asp-for="Date" type="date" class="form-control" required />
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>What happened? (Description)</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Action Taken / Intervention</label>
            <input asp-for="ActionTaken" class="form-control" />
            <span asp-validation-for="ActionTaken" class="text-danger"></span>
        </div>

        <br />
        <button type="submit" class="btn btn-primary">Save Incident</button>
        <a asp-action="Index" class="btn btn-secondary">View All Reports</a>
    </form>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
        $('#TeacherId').change(function () {
        var selectedId = $(this).val();
        var $studentDrop = $('#StudentDropdown');

        // Clear and show loading
        $studentDrop.empty().append('<option>Loading roster...</option>');

        if (selectedId) {
        // Call the "GetStudentsByTeacher" method in your Controller
        $.getJSON('/Incident/GetStudentsByTeacher', { teacherId: selectedId }, function (data) {
        $studentDrop.empty().append('<option value="">-- Select Student --</option>');
                        
        $.each(data, function (i, student) {
        $studentDrop.append($('<option>', {
        value: student.name, // Saves student name to Incident record
        text: student.name
        }));
        });
        });
        } else {
        $studentDrop.empty().append('<option value="">-- Select a Teacher First --</option>');
        }
        });
        });
    </script>
}