@using SchoolManagmentSystem.Models
@model List<SchoolManagmentSystem.Models.LeaveRequest>

@{
    ViewData["Title"] = "Leave Requests";
}

<style>
    .leave-page {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .page-header {
        margin-bottom: 30px;
    }

        .page-header h2 {
            font-size: 30px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .page-header p {
            color: #777;
            margin: 0;
        }

    .alert {
        padding: 14px 18px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .alert-success {
        background: #eaf8ef;
        color: #217a3a;
    }

    .alert-danger {
        background: #fdecec;
        color: #a52828;
    }

    .leave-table-container {
        background: white;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.06);
        overflow: hidden;
    }

    .leave-table {
        width: 100%;
        border-collapse: collapse;
    }

        .leave-table th {
            background: #f7f7fb;
            padding: 16px;
            text-align: left;
            font-size: 14px;
            font-weight: 600;
            color: #555;
        }

        .leave-table td {
            padding: 16px;
            border-top: 1px solid #eee;
            vertical-align: middle;
        }

        .leave-table tr:hover {
            background: #fafafa;
        }

    .status {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-pending {
        background: #fff4d6;
        color: #9a6b00;
    }

    .status-approved {
        background: #e6f7ec;
        color: #237a3b;
    }

    .status-rejected {
        background: #fde7e7;
        color: #a32929;
    }

    .status-cancelled {
        background: #eeeeee;
        color: #666;
    }

    .actions {
        display: flex;
        gap: 8px;
    }

    .action-form {
        display: inline;
        margin: 0;
    }

    .btn {
        border: none;
        border-radius: 8px;
        padding: 9px 15px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-approve {
        background: #e7f7ec;
        color: #237a3b;
    }

        .btn-approve:hover {
            background: #d5f0dc;
        }

    .btn-reject {
        background: #fde7e7;
        color: #a32929;
    }

        .btn-reject:hover {
            background: #f9d5d5;
        }

    .no-requests {
        padding: 50px;
        text-align: center;
        color: #777;
    }

    .reason {
        max-width: 250px;
        white-space: normal;
        word-break: break-word;
    }

    @@media (max-width: 900px) {
        .leave-table-container {
            overflow-x: auto;
        }

        .leave-table {
            min-width: 950px;
        }
    }
</style>

<div class="leave-page">

    <div class="page-header">
        <h2>Leave Requests</h2>
        <p>Review and manage staff leave requests.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="leave-table-container">

        @if (Model == null || !Model.Any())
        {
            <div class="no-requests">
                <h4>No leave requests</h4>
                <p>There are currently no leave requests to review.</p>
            </div>
        }
        else
        {
            <table class="leave-table">

                <thead>
                    <tr>
                        <th>Staff ID</th>
                        <th>Leave Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Days</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var request in Model)
                    {
                        int days = (request.EndDate.Date - request.StartDate.Date).Days + 1;

                        <tr>

                            <td>
                                <strong>#@request.StaffId</strong>
                            </td>

                            <td>
                                @request.Type
                            </td>

                            <td>
                                @request.StartDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @request.EndDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @days
                            </td>

                            <td>
                                <div class="reason">
                                    @request.Reason
                                </div>
                            </td>

                            <td>

                                @if (request.Status == LeaveRequestStatus.PendingHODReview)
                                {
                                    <span class="status status-pending">
                                        Pending HOD Review
                                    </span>
                                }
                                else if (request.Status == LeaveRequestStatus.Approved)
                                {
                                    <span class="status status-approved">
                                        Approved
                                    </span>
                                }
                                else if (request.Status == LeaveRequestStatus.Rejected)
                                {
                                    <span class="status status-rejected">
                                        Rejected
                                    </span>
                                }
                                else if (request.Status == LeaveRequestStatus.CancelledByTeacher)
                                {
                                    <span class="status status-cancelled">
                                        Cancelled
                                    </span>
                                }

                            </td>

                            <td>

                                @if (request.Status == LeaveRequestStatus.PendingHODReview)
                                {
                                    <div class="actions">

                                        <form asp-controller="LeaveManagement"
                                              asp-action="Approve"
                                              method="post"
                                              class="action-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@request.Id" />

                                            <button type="submit"
                                                    class="btn btn-approve"
                                                    onclick="return confirm('Are you sure you want to approve this leave request?');">
                                                Approve
                                            </button>

                                        </form>

                                        <form asp-controller="LeaveManagement"
                                              asp-action="Reject"
                                              method="post"
                                              class="action-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@request.Id" />

                                            <button type="submit"
                                                    class="btn btn-reject"
                                                    onclick="return confirm('Are you sure you want to reject this leave request?');">
                                                Reject
                                            </button>

                                        </form>

                                    </div>
                                }
                                else
                                {
                                    <span style="color:#999;">
                                        No action
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }

    </div>

</div>