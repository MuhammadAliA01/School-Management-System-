@{
    ViewData["Title"] = "Regenerate Payslip";
}

<style>
    .regenerate-page {
        max-width: 1100px;
        margin: 45px auto;
        padding: 0 25px;
    }

    .page-header {
        margin-bottom: 30px;
    }

        .page-header h2 {
            margin: 0;
            font-size: 30px;
            font-weight: 700;
            color: #25213b;
        }

        .page-header p {
            margin-top: 8px;
            color: #77738a;
            font-size: 15px;
        }

    .search-panel {
        background: #fff;
        border-radius: 16px;
        padding: 25px 28px;
        box-shadow: 0 8px 30px rgba(40, 32, 70, 0.07);
        border: 1px solid #f5e3d0;
        margin-bottom: 30px;
    }

    .search-title {
        font-size: 17px;
        font-weight: 600;
        color: #302b48;
        margin-bottom: 18px;
    }

    .input-group label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #5f5a70;
        margin-bottom: 8px;
    }

    .staff-input {
        width: 100%;
        height: 46px;
        border: 1px solid #f0c9a0;
        border-radius: 10px;
        padding: 0 14px;
        font-size: 15px;
        color: #302b48;
        outline: none;
        box-sizing: border-box;
        background: #fff;
        transition: 0.2s;
    }

        .staff-input:focus {
            border-color: #ff8a3d;
            box-shadow: 0 0 0 3px rgba(255, 138, 61, 0.12);
        }

    .staff-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .staff-chip {
        padding: 9px 16px;
        border: 1px solid #f0c9a0;
        background: #fff;
        color: #302b48;
        border-radius: 20px;
        cursor: pointer;
        font-size: 14px;
        transition: 0.2s;
    }

        .staff-chip:hover {
            background: #fff6ee;
        }

        .staff-chip.active {
            background: #ff8a3d;
            color: #fff;
            border-color: #ff8a3d;
        }

    .date-row {
        display: flex;
        gap: 14px;
        margin-top: 20px;
    }

        .date-row .input-group {
            flex: 1;
        }

    .history-panel {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 8px 30px rgba(40, 32, 70, 0.07);
        border: 1px solid #f5e3d0;
        overflow: hidden;
    }

    .history-header {
        padding: 22px 25px;
        border-bottom: 1px solid #f5e3d0;
    }

        .history-header h3 {
            margin: 0;
            font-size: 18px;
            color: #302b48;
            font-weight: 650;
        }

        .history-header p {
            margin: 5px 0 0;
            color: #858092;
            font-size: 13px;
        }

    .table-wrapper {
        overflow-x: auto;
    }

    #historyTable {
        width: 100%;
        border-collapse: collapse;
        border: none;
    }

        #historyTable thead {
            background: #fff6ee;
        }

        #historyTable th {
            padding: 15px 20px;
            text-align: left;
            font-size: 12px;
            font-weight: 700;
            color: #a06a3a;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            border-bottom: 1px solid #f5e3d0;
            white-space: nowrap;
        }

        #historyTable td {
            padding: 17px 20px;
            font-size: 14px;
            color: #454052;
            border-bottom: 1px solid #f8ece0;
            vertical-align: middle;
        }

        #historyTable tbody tr:hover {
            background: #fffaf5;
        }

        #historyTable tbody tr:last-child td {
            border-bottom: none;
        }

    .payslip-id {
        font-weight: 650;
        color: #302b48;
    }

    .period {
        color: #666174;
    }

    .version-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        height: 26px;
        padding: 0 9px;
        border-radius: 20px;
        background: #fff0e2;
        color: #d9711f;
        font-size: 12px;
        font-weight: 700;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 11px;
        border-radius: 20px;
        background: #eef8f2;
        color: #27834d;
        font-size: 12px;
        font-weight: 650;
    }

    .regenerate-button {
        border: none;
        background: #ff8a3d;
        color: #fff;
        padding: 9px 15px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

        .regenerate-button:hover {
            background: #f07627;
            transform: translateY(-1px);
        }

    .empty-state {
        display: none;
        text-align: center;
        padding: 55px 20px;
        color: #817c8d;
    }

    .empty-icon {
        width: 50px;
        height: 50px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: #fff0e2;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ff8a3d;
        font-size: 22px;
    }

    .empty-state h4 {
        margin: 0 0 6px;
        color: #403b4e;
        font-size: 16px;
    }

    .empty-state p {
        margin: 0;
        font-size: 13px;
    }

    .prompt-state {
        text-align: center;
        padding: 45px 20px;
        color: #a08a75;
        font-size: 14px;
    }

    .loading {
        display: none;
        text-align: center;
        padding: 35px;
        color: #77738a;
        font-size: 14px;
    }

    .spinner {
        width: 22px;
        height: 22px;
        border: 3px solid #ffe3cc;
        border-top-color: #ff8a3d;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 10px;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .error-message {
        display: none;
        margin-top: 12px;
        padding: 11px 14px;
        border-radius: 8px;
        background: #fff1f1;
        color: #c33f3f;
        font-size: 13px;
    }

    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(30, 20, 10, 0.35);
        z-index: 999;
        align-items: center;
        justify-content: center;
    }

    .modal-box {
        background: #fff;
        border-radius: 14px;
        padding: 26px 28px;
        width: 380px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.15);
    }

        .modal-box h4 {
            margin: 0 0 12px;
            color: #302b48;
        }

    .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 16px;
        justify-content: flex-end;
    }

    .modal-cancel {
        background: #f5f5f5;
        border: none;
        padding: 9px 16px;
        border-radius: 8px;
        cursor: pointer;
    }

    .modal-confirm {
        background: #ff8a3d;
        color: #fff;
        border: none;
        padding: 9px 16px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }

        .modal-confirm:hover {
            background: #f07627;
        }

    @@media (max-width: 700px) {
        .regenerate-page {
            margin: 25px auto;
            padding: 0 15px;
        }

        .page-header h2 {
            font-size: 25px;
        }

        .date-row {
            flex-direction: column;
        }

        .search-panel {
            padding: 20px;
        }

        #historyTable th, #historyTable td {
            padding: 13px 14px;
        }
    }
</style>

<div class="regenerate-page">

    <div class="page-header">
        <h2>Regenerate Payslip</h2>
        <p>Select an employee to view their payslip history, then regenerate the one you need.</p>
    </div>

    <div class="search-panel">
        <div class="search-title">Select Employee</div>
        <input type="text" id="staffSearch" class="staff-input" placeholder="Search by name or staff ID..." oninput="filterStaffList()" style="margin-bottom:12px;" />

        <div class="input-group">
            <div id="staffList" class="staff-chips"></div>
        </div>

        <div class="date-row">
            <div class="input-group">
                <label for="fromDate">From (optional)</label>
                <input type="date" id="fromDate" class="staff-input" onchange="loadHistory()" />
            </div>
            <div class="input-group">
                <label for="toDate">To (optional)</label>
                <input type="date" id="toDate" class="staff-input" onchange="loadHistory()" />
            </div>
        </div>

        <div id="errorMessage" class="error-message"></div>
    </div>

    <div id="successMessage" style="display:none; margin-bottom:20px; padding:14px 18px; border-radius:10px; background:#eef8f2; color:#27834d; font-size:14px; font-weight:600;"></div>
    <div class="history-panel">

        <div class="history-header">
            <h3>Payslip History</h3>
            <p>Payslips previously generated for the selected employee.</p>
        </div>

        <div id="promptState" class="prompt-state">Select an employee above to see their payslips.</div>

        <div id="loading" class="loading">
            <div class="spinner"></div>
            Loading payslip history...
        </div>

        <div class="table-wrapper">
            <table id="historyTable" style="display: none;">
                <thead>
                    <tr>
                        <th>Payslip ID</th>
                        <th>Pay Period</th>
                        <th>Status</th>
                        <th>Version</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="historyBody"></tbody>
            </table>
        </div>

        <div id="emptyState" class="empty-state">
            <div class="empty-icon">📄</div>
            <h4>No Payslips Found</h4>
            <p>No payslips were found for this employee in the selected range.</p>
        </div>

    </div>

</div>

<div id="reasonModal" class="modal-overlay">
    <div class="modal-box">
        <h4>Reason for regeneration</h4>
        <input id="reasonInput" type="text" placeholder="e.g. Corrected calculation error" class="staff-input" />
        <div class="modal-actions">
            <button class="modal-cancel" onclick="closeReasonModal()">Cancel</button>
            <button class="modal-confirm" onclick="confirmRegenerate()">Regenerate</button>
        </div>
    </div>
</div>

<script>
        let selectedStaffId = null;
        let pendingPayslipId = null;
        let allStaff = [];

    async function loadStaffList() {
        const res = await fetch("/Payslip/GetStaffList");
        allStaff = await res.json();
        renderStaffList(allStaff);
    }

    function renderStaffList(staff) {
        document.getElementById("staffList").innerHTML = staff.map(s =>
            `<button type="button" class="staff-chip ${s.id === selectedStaffId ? 'active' : ''}" id="chip-${s.id}" onclick="selectStaff(${s.id})">${s.name} (ID ${s.id})</button>`
        ).join("");
    }

    function filterStaffList() {
        const term = document.getElementById("staffSearch").value.toLowerCase();
        const filtered = allStaff.filter(s =>
            s.name.toLowerCase().includes(term) || String(s.id).includes(term)
        );
        renderStaffList(filtered);
    }

    function selectStaff(id) {
        selectedStaffId = id;
        document.querySelectorAll(".staff-chip").forEach(c => c.classList.remove("active"));
        document.getElementById("chip-" + id).classList.add("active");
        loadHistory();
    }

    async function loadHistory() {
        if (!selectedStaffId) return;

        const table = document.getElementById("historyTable");
        const body = document.getElementById("historyBody");
        const loading = document.getElementById("loading");
        const emptyState = document.getElementById("emptyState");
        const promptState = document.getElementById("promptState");
        const errorMessage = document.getElementById("errorMessage");

        const from = document.getElementById("fromDate").value;
        const to = document.getElementById("toDate").value;

        errorMessage.style.display = "none";
        promptState.style.display = "none";
        table.style.display = "none";
        emptyState.style.display = "none";
        body.innerHTML = "";
        loading.style.display = "block";

        try {
            const response = await fetch(`/Payslip/History?staffId=${selectedStaffId}&from=${from}&to=${to}`);
            if (!response.ok) throw new Error("Unable to load payslip history.");

            const data = await response.json();
            loading.style.display = "none";

            if (!data || data.length === 0) {
                emptyState.style.display = "block";
                return;
            }

            data.forEach(p => {
                const row = document.createElement("tr");
                const startDate = new Date(p.payPeriodStart);
                const endDate = new Date(p.payPeriodEnd);

                row.innerHTML = `
                    <td><span class="payslip-id">#${p.payslipId}</span></td>
                    <td><span class="period">${startDate.toLocaleDateString()} - ${endDate.toLocaleDateString()}</span></td>
                    <td><span class="status-badge">${p.status}</span></td>
                    <td><span class="version-badge">v${p.currentVersion}</span></td>
                    <td><button type="button" class="regenerate-button" onclick="openReasonModal(${p.payslipId})">Regenerate</button></td>
                `;
                body.appendChild(row);
            });

            table.style.display = "table";
        } catch (error) {
            loading.style.display = "none";
            showError(error.message);
        }
    }

    function openReasonModal(payslipId) {
        pendingPayslipId = payslipId;
        document.getElementById("reasonInput").value = "";
        document.getElementById("reasonModal").style.display = "flex";
        document.getElementById("reasonInput").focus();
    }

    function closeReasonModal() {
        document.getElementById("reasonModal").style.display = "none";
        pendingPayslipId = null;
    }

    async function confirmRegenerate() {
        const reason = document.getElementById("reasonInput").value.trim();
        if (!reason) return;

        const formData = new URLSearchParams();
        formData.append("payslipId", pendingPayslipId);
        formData.append("regenerationReason", reason);

        try {
            const response = await fetch("/Payslip/Regenerate", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: formData
            });

            closeReasonModal();

            if (response.ok) {
                showSuccess("Payslip regenerated successfully.");
                loadHistory();
            } else {
                const message = await response.text();
                showError(message || "Unable to regenerate the payslip.");
            }
        } catch (error) {
            closeReasonModal();
            showError("An error occurred while regenerating the payslip.");
        }
    }

    function showSuccess(message) {
        const successMessage = document.getElementById("successMessage");
        successMessage.textContent = message;
        successMessage.style.display = "block";
        setTimeout(() => { successMessage.style.display = "none"; }, 3000);
    }

    function showError(message) {
        const errorMessage = document.getElementById("errorMessage");
        errorMessage.textContent = message;
        errorMessage.style.display = "block";
    }

    document.getElementById("reasonInput").addEventListener("keydown", function (event) {
        if (event.key === "Enter") confirmRegenerate();
    });

    loadStaffList();
</script>