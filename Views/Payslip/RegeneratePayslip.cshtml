@{
    ViewData["Title"] = "Regenerate Payslip";
}

<h3>Regenerate Payslip</h3>

<div>
    <label>Staff ID:</label>
    <input type="number" id="staffId" />
    <button onclick="loadHistory()">Load</button>
</div>

<table id="historyTable" border="1" style="margin-top:15px; display:none;">
    <thead>
        <tr>
            <th>Payslip ID</th>
            <th>Period</th>
            <th>Status</th>
            <th>Version</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody id="historyBody"></tbody>
</table>

<script>
    async function loadHistory() {
        const staffId = document.getElementById('staffId').value;
        const res = await fetch(`/Payslip/History?staffId=${staffId}`);
        const data = await res.json();

        const body = document.getElementById('historyBody');
        body.innerHTML = '';

        data.forEach(p => {
            const row = document.createElement('tr');
            row.innerHTML = `
                <td>${p.payslipId}</td>
                <td>${new Date(p.payPeriodStart).toLocaleDateString()} - ${new Date(p.payPeriodEnd).toLocaleDateString()}</td>
                <td>${p.status}</td>
                <td>${p.currentVersion}</td>
                <td><button onclick="regenerate(${p.payslipId})">Regenerate</button></td>
            `;
            body.appendChild(row);
        });

        document.getElementById('historyTable').style.display = data.length ? 'table' : 'none';
    }

    async function regenerate(payslipId) {
        const reason = prompt("Reason for regeneration:");
        if (!reason) return;

        const formData = new URLSearchParams();
        formData.append('payslipId', payslipId);
        formData.append('regenerationReason', reason);

        const res = await fetch('/Payslip/Regenerate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formData
        });

        if (res.ok) {
            alert("Regenerated successfully.");
            loadHistory();
        } else {
            alert(await res.text());
        }
    }
</script>