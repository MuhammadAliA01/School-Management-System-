@model List<Staff>

@{
    ViewData["Title"] = "Select Staff for Payslips";
}

<style>
    .payslip-container {
        max-width: 900px;
        margin: 40px auto;
    }

    .payslip-header {
        margin-bottom: 25px;
    }

        .payslip-header h3 {
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 6px;
            color: #252525;
        }

        .payslip-header p {
            color: #777;
            margin: 0;
        }

    .payslip-card {
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .period-section {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 30px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .form-group label {
            font-size: 14px;
            font-weight: 600;
            color: #333;
        }

        .form-group input[type="date"] {
            width: 100%;
            padding: 11px 13px;
            border: 1px solid #d8d8d8;
            border-radius: 7px;
            font-size: 14px;
            box-sizing: border-box;
            outline: none;
        }

            .form-group input[type="date"]:focus {
                border-color: #4f46e5;
                box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
            }

    .staff-section {
        margin-top: 10px;
    }

    .staff-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 15px;
        border-bottom: 1px solid #eeeeee;
    }

        .staff-header h4 {
            margin: 0;
            font-size: 17px;
            font-weight: 600;
            color: #333;
        }

    .select-all {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        color: #555;
        cursor: pointer;
    }

        .select-all input {
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

    .staff-list {
        margin-top: 5px;
    }

    .staff-row {
        display: flex;
        align-items: center;
        padding: 15px 10px;
        border-bottom: 1px solid #f0f0f0;
        transition: background-color 0.15s ease;
    }

        .staff-row:hover {
            background-color: #f8f8ff;
        }

        .staff-row:last-child {
            border-bottom: none;
        }

        .staff-row input[type="checkbox"] {
            width: 17px;
            height: 17px;
            margin-right: 12px;
            cursor: pointer;
        }

    .staff-name {
        font-size: 15px;
        color: #333;
    }

    .staff-id {
        margin-left: auto;
        font-size: 12px;
        color: #999;
    }

    .form-footer {
        display: flex;
        justify-content: flex-end;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #eeeeee;
    }

    .next-button {
        border: none;
        border-radius: 7px;
        padding: 11px 28px;
        background: #4f46e5;
        color: white;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .next-button:hover {
            background: #4338ca;
        }

    .empty-staff {
        padding: 30px;
        text-align: center;
        color: #888;
    }

    @@media (max-width: 700px) {
        .payslip-container {
            margin: 20px 15px;
        }

        .period-section {
            grid-template-columns: 1fr;
        }

        .payslip-card {
            padding: 20px;
        }

        .staff-header {
            align-items: flex-start;
            gap: 10px;
        }
    }
</style>

<div class="payslip-container">

    <div class="payslip-header">
        <h3>Generate Payslips</h3>
        <p>
            Choose the pay period and select the staff members who should receive payslips.
        </p>
    </div>

    <form method="post"
          asp-controller="PayslipDistribution"
          asp-action="SelectStaff">

        <div class="payslip-card">

        
            <div class="staff-section">

                <div class="staff-header">

                    <h4>Select Staff</h4>

                    <label class="select-all">
                        <input type="checkbox"
                               id="selectAll"
                               checked />

                        Select All Staff
                    </label>

                </div>

                <div class="staff-list">

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var staff in Model)
                        {
                            <div class="staff-row">

                                <input type="checkbox"
                                       name="staffIds"
                                       value="@staff.id"
                                       checked />

                                <span class="staff-name">
                                    @staff.FirstName @staff.Surname
                                </span>

                                <span class="staff-id">
                                    ID: @staff.id
                                </span>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-staff">
                            No staff members found.
                        </div>
                    }

                </div>

            </div>

            <div class="form-footer">

                <button type="submit" class="next-button">
                    Next
                </button>

            </div>

        </div>

    </form>

</div>

<script>
    document.getElementById('selectAll').addEventListener('change', function () {

        document
            .querySelectorAll('input[name="staffIds"]')
            .forEach(function (checkbox) {
                checkbox.checked = this.checked;
            }, this);

    });
</script>
