@model List<Staff>

@{
    ViewData["Title"] = "Select Staff for Payslips";
}

<style>
    body {
        min-height: 100vh;
        margin: 0;
        background-color: #fdfcfb;
        background-image: repeating-radial-gradient(
            circle at 100% 100%,
            transparent 0,
            transparent 40px,
            rgba(234, 88, 12, 0.05) 40px,
            rgba(234, 88, 12, 0.05) 41.5px
        );
        background-attachment: fixed;
    }

    .payslip-container {
        max-width: 900px;
        margin: 50px auto;
        background: transparent;
    }

    .payslip-header {
        margin-bottom: 35px;
    }

        .payslip-header h3 {
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 8px;
            color: #c2410c;
        }

        .payslip-header p {
            color: #64748b;
            margin: 0;
        }

    .payslip-card {
        background: #ffffff;
        border: 1px solid #fed7aa;
        border-radius: 14px;
        padding: 30px;
        box-shadow: 0 4px 18px rgba(234, 88, 12, 0.04);
    }

    .staff-section {
        margin-top: 0;
    }

    .staff-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 0 15px;
        border-bottom: 1px solid #ffedd5;
    }

        .staff-header h4 {
            margin: 0;
            font-size: 17px;
            font-weight: 600;
            color: #1e293b;
        }

    .select-all {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        color: #64748b;
        cursor: pointer;
    }

        .select-all input {
            width: 16px;
            height: 16px;
            cursor: pointer;
            accent-color: #ea580c;
        }

    .staff-list {
        margin-top: 5px;
    }

    .staff-row {
        display: flex;
        align-items: center;
        padding: 15px 10px;
        border-bottom: 1px solid #f1f5f9;
        transition: background-color 0.15s ease;
        border-radius: 7px;
    }

        .staff-row:hover {
            background-color: #fffaf5;
        }

        .staff-row:last-child {
            border-bottom: none;
        }

        .staff-row input[type="checkbox"] {
            width: 17px;
            height: 17px;
            margin-right: 12px;
            cursor: pointer;
            accent-color: #ea580c;
        }

    .staff-name {
        font-size: 15px;
        color: #334155;
    }

    .staff-id {
        margin-left: auto;
        font-size: 12px;
        color: #94a3b8;
    }

    .form-footer {
        display: flex;
        justify-content: flex-end;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #ffedd5;
    }

    .next-button {
        border-radius: 7px;
        padding: 6px 15px;
        background-color: orangered;
        color: #ffffff;
        border: 1px solid #ffffff;
        box-shadow: 0 0 0 1px orangered,
                    0 4px 10px rgba(255, 69, 0, 0.25);
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
    }

        .next-button:hover {
            background-color: orangered;
            color: #ffffff;
            box-shadow: 0 0 0 1px orangered,
                        0 6px 14px rgba(255, 69, 0, 0.35);
            transform: translateY(-1px);
        }

    .empty-staff {
        padding: 30px;
        text-align: center;
        color: #94a3b8;
    }

    @@media (max-width: 700px) {

        .payslip-container {
            margin: 30px 15px;
        }

        .payslip-card {
            padding: 20px;
        }

        .staff-header {
            align-items: flex-start;
            gap: 10px;
        }
    }
</style>


<div class="payslip-container">

    <div class="payslip-header">

        <h3>Generate Payslips</h3>

        <p>
            Choose the staff members who should receive payslips.
        </p>

    </div>


    <form method="post"
          asp-controller="PayslipDistribution"
          asp-action="SelectStaff">

        <div class="payslip-card">

            <div class="staff-section">

                <div class="staff-header">

                    <h4>Select Staff</h4>

                    <label class="select-all">

                        <input type="checkbox"
                               id="selectAll"
                               checked />

                        Select All Staff

                    </label>

                </div>


                <div class="staff-list">

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var staff in Model)
                        {
                            <div class="staff-row">

                                <input type="checkbox"
                                       name="staffIds"
                                       value="@staff.id"
                                       checked />

                                <span class="staff-name">
                                    @staff.FirstName @staff.Surname
                                </span>

                                <span class="staff-id">
                                    ID: @staff.id
                                </span>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-staff">
                            No staff members found.
                        </div>
                    }

                </div>

            </div>


            <div class="form-footer">

                <button type="submit" class="next-button">
                    Next
                </button>

            </div>

        </div>

    </form>

</div>


<script>
    document.getElementById('selectAll').addEventListener('change', function () {

        document
            .querySelectorAll('input[name="staffIds"]')
            .forEach(function (checkbox) {
                checkbox.checked = this.checked;
            }, this);

    });
</script>
