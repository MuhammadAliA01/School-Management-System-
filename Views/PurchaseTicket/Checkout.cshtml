@{
    ViewData["Title"] = "Secure Checkout";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                <div class="bg-primary bg-gradient p-4 text-white text-center">
                    <h3 class="fw-bold mb-1"><i class="bi bi-lock-fill me-2"></i>Secure Checkout</h3>
                    <p class="mb-0 text-white-50">Complete your transaction for the upcoming event</p>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">

                    <div class="d-flex justify-content-between align-items-center mb-4 pb-4 border-bottom">
                        <div>
                            <span class="text-muted text-uppercase fw-bold" style="font-size: 0.85rem;">Order Summary</span>
                            <h5 class="fw-bold text-dark mt-1 mb-0">@ViewBag.Quantity General Admission Ticket(s)</h5>
                        </div>
                        <div class="text-end">
                            <span class="text-muted text-uppercase fw-bold" style="font-size: 0.85rem;">Total Due</span>
                            <h3 class="fw-bold text-success mt-1 mb-0">R @ViewBag.Amount.ToString("F2")</h3>
                        </div>
                    </div>

                    <form asp-action="ProcessStripePayment" method="post" id="payment-form" class="needs-validation" novalidate>

                        <input type="hidden" name="eventId" value="@ViewBag.EventId" />
                        <input type="hidden" name="quantity" value="@ViewBag.Quantity" />
                        <input type="hidden" name="amount" value="@ViewBag.Amount" />

                        <h5 class="mb-3 fw-bold text-dark">Payment Details</h5>

                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" id="cardHolderName" name="cardHolderName" placeholder="John Doe" required pattern="^[a-zA-Z\s]+$">
                            <label for="cardHolderName">Name on Card</label>
                            <div class="invalid-feedback">
                                Please enter the name exactly as it appears on your card (letters only).
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" id="cardNumber" placeholder="0000 0000 0000 0000" maxlength="19" required>
                            <label for="cardNumber"><i class="bi bi-credit-card-2-front me-2"></i>Card Number</label>
                            <div class="invalid-feedback">
                                Please enter a valid 16-digit card number.
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="cardExpiry" placeholder="MM/YY" maxlength="5" required pattern="(0[1-9]|1[0-2])\/[0-9]{2}">
                                    <label for="cardExpiry">Expiry Date (MM/YY)</label>
                                    <div class="invalid-feedback">
                                        Please enter a valid expiry date (e.g., 12/26).
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6 mb-4">
                                <div class="form-floating">
                                    <input type="password" class="form-control" id="cardCvc" placeholder="123" maxlength="3" required pattern="\d{3}">
                                    <label for="cardCvc">Security Code (CVC)</label>
                                    <div class="invalid-feedback">
                                        Please enter the 3-digit code on the back of your card.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold py-3 shadow-sm rounded-3 transition-all" id="submitBtn">
                            Pay R @ViewBag.Amount.ToString("F2")
                        </button>

                        <div class="text-center mt-4">
                            <p class="text-muted small mb-0">
                                <i class="bi bi-shield-check text-success me-1"></i>
                                Payments are secured and encrypted by <strong>Stripe</strong>.
                            </p>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-controller="Event" asp-action="Index" class="text-decoration-none text-muted fw-bold link-hover">
                    <i class="bi bi-arrow-left me-1"></i> Return to Events
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const form = document.getElementById('payment-form');
            const cardNumber = document.getElementById('cardNumber');
            const cardExpiry = document.getElementById('cardExpiry');
            const cardCvc = document.getElementById('cardCvc');

            // 1. Format Card Number (Add spaces every 4 digits)
            cardNumber.addEventListener('input', function (e) {
                let target = e.target;
                let val = target.value.replace(/\D/g, '');
                target.value = val.replace(/(\d{4})(?=\d)/g, '$1 ');
            });

            // 2. Format Expiry Date (Smarter Handling)
            cardExpiry.addEventListener('input', function (e) {
                if (e.inputType === 'deleteContentBackward') return;

                let target = e.target;
                let val = target.value.replace(/\D/g, '');

                if (val.length === 1 && parseInt(val) > 1) {
                    val = '0' + val;
                }

                if (val.length >= 2) {
                    target.value = val.substring(0, 2) + '/' + val.substring(2, 4);
                } else {
                    target.value = val;
                }
            });

            // 3. Restrict CVC to numbers only
            cardCvc.addEventListener('input', function (e) {
                let target = e.target;
                target.value = target.value.replace(/\D/g, '');
            });

            // 4. Submit Validation Interceptor (Includes Time-Travel Logic)
            form.addEventListener('submit', function (event) {
                let isValid = true;

                if (!form.checkValidity()) {
                    isValid = false;
                }

                if (cardNumber.value.length < 19) {
                    cardNumber.setCustomValidity("Incomplete");
                    isValid = false;
                } else {
                    cardNumber.setCustomValidity("");
                }

                const expiryRegex = /^(0[1-9]|1[0-2])\/([0-9]{2})$/;
                const expiryFeedback = cardExpiry.parentElement.querySelector('.invalid-feedback');

                if (!expiryRegex.test(cardExpiry.value)) {
                    cardExpiry.setCustomValidity("Invalid format");
                    expiryFeedback.innerText = "Please enter a valid expiry date (e.g., 12/26).";
                    isValid = false;
                } else {
                    const parts = cardExpiry.value.split('/');
                    const inputMonth = parseInt(parts[0], 10);
                    const inputYear = parseInt(parts[1], 10);

                    const currentDate = new Date();
                    const currentYear = parseInt(currentDate.getFullYear().toString().slice(-2), 10);
                    const currentMonth = currentDate.getMonth() + 1;

                    if (inputYear < currentYear || (inputYear === currentYear && inputMonth < currentMonth)) {
                        cardExpiry.setCustomValidity("Card expired");
                        expiryFeedback.innerText = "This card has expired. Please use a valid card.";
                        isValid = false;
                    } else {
                        cardExpiry.setCustomValidity("");
                    }
                }

                if (!isValid) {
                    event.preventDefault();
                    event.stopPropagation();
                }

                form.classList.add('was-validated');
            }, false);
        });
    </script>

    <style>
        .transition-all {
            transition: all 0.2s ease-in-out;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

        .form-floating > label {
            color: #6c757d;
            font-weight: 500;
        }

        .link-hover:hover {
            color: #0d6efd !important;
        }
    </style>
}
