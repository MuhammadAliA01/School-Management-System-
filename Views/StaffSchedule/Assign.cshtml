@model SchoolManagmentSystem.Models.AssignScheduleViewModel

@{
    ViewData["Title"] = "Automated Staff Scheduling";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-cpu"></i> Automated Scheduling Dashboard</h2>
        <span class="badge bg-info text-dark fs-6">Target Date: @Model.TargetScheduleDate.ToShortDateString()</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong><i class="bi bi-check-circle-fill"></i> System Update:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Panel 1: Unassigned Classes -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-warning text-dark fw-bold">
                    Pending Shifts / Classes (@Model.UnassignedClasses.Count)
                </div>
                <div class="card-body">
                    @if (!Model.UnassignedClasses.Any())
                    {
                        <p class="text-success fw-bold">All shifts for @Model.TargetScheduleDate.ToShortDateString() are currently covered.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var cls in Model.UnassignedClasses)
                            {
                                // Adjust "ClassName" to whatever property you use for the class title
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Class ID: @cls.ClassId
                                    <span class="badge bg-danger rounded-pill">Unassigned</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <!-- Panel 2: Available Staff -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-primary text-white fw-bold">
                    Available Roster (@Model.AvailableStaff.Count Staff Members)
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var staff in Model.AvailableStaff)
                        {
                            // Adjust "FirstName" / "LastName" to match your Employee properties
                            <li class="list-group-item">
                                <i class="bi bi-person-circle text-secondary me-2"></i> @staff.Id (ID)
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- The Automation Trigger -->
    <div class="card border-0 shadow-sm mt-2">
        <div class="card-body text-center p-5 bg-light">
            <h4 class="mb-3">Run Automated Assignment</h4>
            <p class="text-muted mb-4">This will distribute all pending shifts evenly among available staff using a round-robin algorithm for @Model.TargetScheduleDate.ToShortDateString().</p>

            <form asp-action="RunAutoAssign" method="post">
                <button type="submit" class="btn btn-success btn-lg px-5 shadow" @(Model.UnassignedClasses.Any() ? "" : "disabled")>
                    <i class="bi bi-lightning-fill"></i> Execute Auto-Assign
                </button>
            </form>
        </div>
    </div>
</div>