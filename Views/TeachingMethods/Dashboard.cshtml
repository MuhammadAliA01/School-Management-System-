@model IEnumerable<SchoolManagmentSystem.Models.Student>

<style>
    body {
        background-color: #fffaf0;
        font-family: 'Dubai', 'Segoe UI', sans-serif;
    }

    .dashboard-banner {
        background-color: #ff8c00; 
        color: white;
        padding: 50px 0 70px 0;
        text-align: center;
        border-radius: 0 0 40px 40px;
        box-shadow: 0 4px 15px rgba(255, 140, 0, 0.2);
    }

    /* Centered Search Bar */
    .search-container {
        max-width: 550px;
        margin: -30px auto 40px auto;
        position: relative;
        z-index: 10;
    }

    .search-input {
        height: 55px;
        border-radius: 25px;
        padding-left: 25px;
        border: 2px solid #ffedcc;
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
        font-size: 16px;
    }

        .search-input:focus {
            box-shadow: 0 8px 25px rgba(255, 140, 0, 0.15);
            border: 2px solid #ff8c00;
            outline: none;
        }

    /* Student Cards */
    .student-card {
        background: white;
        border-radius: 18px;
        border: 1px solid #fce4bd;
        transition: 0.3s ease;
    }

        .student-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(255, 140, 0, 0.1);
        }

    /* Initials Circle */
    .avatar-circle {
        width: 45px;
        height: 45px;
        background-color: #fff4e6;
        color: #e67e00;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.2rem;
    }

    /* The AI Button */
    .btn-action {
        background-color: #ff8c00;
        color: white;
        border-radius: 12px;
        padding: 8px 18px;
        text-decoration: none;
        font-weight: 600;
        font-size: 13px;
        transition: 0.2s;
        border: none;
        display: inline-block;
    }

        .btn-action:hover {
            background-color: #e67e00;
            color: white;
            transform: scale(1.03);
        }

    /* Level Badge */
    .badge-custom {
        background-color: #fff9f0;
        color: #d97700;
        border: 1px solid #ffe0b3;
        border-radius: 8px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
    }
</style>

<div class="dashboard-banner">
    <h1 class="fw-bold">Student Directory</h1>
    <p class="opacity-75">Select a student to generate specialized AI teaching methods</p>
</div>

<div class="container">
    <div class="search-container">
        <input type="text" id="studentSearch" class="form-control search-input" placeholder="Search for a student..." onkeyup="filterStudents()">
    </div>

    <div class="row g-4" id="studentGrid">
        @foreach (var student in Model)
        {
            <div class="col-md-6 col-lg-4 student-item">
                <div class="card student-card p-4 shadow-sm">
                    <div class="d-flex align-items-center mb-3">
                        <div class="avatar-circle me-3">
                            @student.FullName.Substring(0, 1)
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold student-name" style="color: #4a3728;">@student.FullName</h5>
                            <small class="text-muted">@student.AutismType</small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <span class="badge-custom">@student.AutismLevel</span>

                        <a asp-controller="TeachingMethods"
                           asp-action="GenerateTeachingMethods"
                           asp-route-id="@student.StudentId"
                           class="btn-action">
                            Generate AI Plan
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function filterStudents() {
        let input = document.getElementById('studentSearch').value.toLowerCase();
        let cards = document.getElementsByClassName('student-item');

        for (let i = 0; i < cards.length; i++) {
            let name = cards[i].querySelector('.student-name').innerText.toLowerCase();
            if (name.includes(input)) {
                cards[i].style.display = "";
            } else {
                cards[i].style.display = "none";
            }
        }
    }
</script>