<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0" style="border-radius: 15px;">

                <div class="card-header bg-primary text-white py-3" style="border-radius: 15px 15px 0 0;">
                    <h3 class="mb-0 text-center"> AI Teaching Strategy</h3>
                </div>

                <div class="card-body p-5">
                    <h4 class="text-secondary mb-4 text-center">Custom Plan for: <span class="text-dark fw-bold">@ViewBag.StudentName</span></h4>

                    <div class="bg-light p-4 shadow-sm" style="border-radius: 10px; white-space: pre-wrap; font-size: 1.1rem; line-height: 1.8; border-left: 5px solid #0d6efd;">
                        @ViewBag.AiAdvice
                    </div>

                    <div class="mt-5 text-center">
                        <a asp-controller="TeachingMethods" asp-action="Dashboard" class="btn btn-outline-secondary px-4 py-2">
                            ← Back to Dashboard
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>