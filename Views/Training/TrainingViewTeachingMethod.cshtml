<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Directory Mockup</title>
    <!-- Bootstrap CSS for layout -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #fffaf0;
            font-family: 'Dubai', 'Segoe UI', sans-serif;
            margin: 0;
            padding-bottom: 50px;
        }

        .dashboard-banner {
            background-color: #ff8c00;
            color: white;
            padding: 50px 0 70px 0;
            text-align: center;
            border-radius: 0 0 40px 40px;
            box-shadow: 0 4px 15px rgba(255, 140, 0, 0.2);
        }

        .search-container {
            max-width: 550px;
            margin: -30px auto 40px auto;
            position: relative;
            z-index: 10;
        }

        .search-input {
            height: 55px;
            border-radius: 25px;
            padding-left: 25px;
            border: 2px solid #ffedcc;
            box-shadow: 0 8px 20px rgba(0,0,0,0.05);
            font-size: 16px;
        }

            .search-input:focus {
                box-shadow: 0 8px 25px rgba(255, 140, 0, 0.15);
                border: 2px solid #ff8c00;
                outline: none;
            }

        .student-card {
            background: white;
            border-radius: 18px;
            border: 1px solid #fce4bd;
            transition: 0.3s ease;
            height: 100%;
        }

            .student-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 25px rgba(255, 140, 0, 0.1);
            }

        .avatar-circle {
            width: 45px;
            height: 45px;
            background-color: #fff4e6;
            color: #e67e00;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 1.2rem;
        }

        
        .btn-action, .btn-log {
            border-radius: 12px;
            padding: 8px 18px;
            text-decoration: none;
            font-weight: 600;
            font-size: 13px;
            transition: 0.2s;
            display: inline-block;
            border: 2px solid transparent;
        }

        
        .btn-action {
            background-color: #ff8c00;
            color: white;
        }

            .btn-action:hover {
                background-color: #e67e00;
                color: white;
                transform: scale(1.03);
            }

     
        .btn-log {
            background-color: transparent;
            color: #ff8c00;
            border-color: #ff8c00;
        }

            .btn-log:hover {
                background-color: #fff4e6;
                color: #e67e00;
                border-color: #e67e00;
                transform: scale(1.03);
            }

        .badge-custom {
            background-color: #fff9f0;
            color: #d97700;
            border: 1px solid #ffe0b3;
            border-radius: 8px;
            padding: 4px 10px;
            font-size: 12px;
            font-weight: 600;
        }
    </style>
</head>
<body>

    <div class="dashboard-banner">
        <h1 class="fw-bold">Student Directory</h1>
        <p class="opacity-75">Select a student to generate specialized AI teaching methods</p>
    </div>

    <div class="container">
        <div class="search-container">
            <input type="text" id="studentSearch" class="form-control search-input" placeholder="Search for a student..." onkeyup="filterStudents()">
        </div>

        <div class="row g-4" id="studentGrid">

          
            <div class="col-md-6 col-lg-4 student-item">
                <div class="card student-card p-4 shadow-sm">
                    <div class="d-flex align-items-center mb-3">
                        <div class="avatar-circle me-3">J</div>
                        <div>
                            <h5 class="mb-0 fw-bold student-name" style="color: #4a3728;">John Doe</h5>
                            <small class="text-muted">Asperger's Syndrome</small>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <div>
                            <span class="badge-custom">Level 1</span>
                            <span class="badge bg-success ms-2 text-white" style="border-radius: 8px; padding: 5px 10px;">Avg: 8.5/10</span>
                        </div>
                        <div class="d-flex gap-2">
                            
                            <a href="/Training/TrainingLogGrade" class="btn-log">Log Grade</a>
                            <a href="/Training/TrainingGenerateMethod" class="btn-action">AI Plan</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        function filterStudents() {
            let input = document.getElementById('studentSearch').value.toLowerCase();
            let cards = document.getElementsByClassName('student-item');

            for (let i = 0; i < cards.length; i++) {
                let name = cards[i].querySelector('.student-name').innerText.toLowerCase();
                if (name.includes(input)) {
                    cards[i].style.display = "";
                } else {
                    cards[i].style.display = "none";
                }
            }
        }
    </script>

</body>
</html>